#!/usr/bin/env bash
# Run any test-*.sh adjacent to this hook when its hooks dir is touched.
# Cheap regression guard for the other hooks; skipped on unrelated commits.
hook_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || repo_root=""
if [ -n "$repo_root" ]; then
    hook_dir_rel="${hook_dir#$repo_root/}"
    if git diff --cached --name-only | grep -q "^${hook_dir_rel}/"; then
        # This runs test-*.sh FROM INSIDE a real `git commit`, which is
        # exactly how a prior test wrote into the real ~/dotfiles/.git/config
        # (git sets GIT_DIR/GIT_WORK_TREE/etc pointing at this real repo for
        # the hook's own environment, and a subprocess inherits them unless
        # cleared). Each test isolates itself too (tests/lib/git-safety.sh),
        # but this is the outer layer: GIT_DIR et al are unset for every test
        # invocation regardless, and the whole run is wrapped in the same
        # config guard tests/run-all.sh uses, so a test that slips past its
        # own isolation still can't corrupt this repo's config unnoticed.
        # shellcheck source=../tests/lib/git-safety.sh
        source "$hook_dir/../tests/lib/git-safety.sh"
        guard_active=0
        guard_dir=""
        if desk_test_config_guard_resolve_repos "$repo_root"; then
            guard_active=1
            guard_dir="$(mktemp -d)"
            desk_test_config_guard_snapshot "$guard_dir" before
            desk_test_state_guard_snapshot "$guard_dir" before
            # Same safe, temp-scoped defaults tests/run-all.sh exports before
            # its own suites (git-safety.sh's own desk_test_safe_env_init):
            # none of these test-*.sh files touch desk-lib today, but a
            # future one that does gets the same net, not a second copy of
            # it to keep in step.
            desk_test_safe_env_init "$guard_dir/safe-env"
        fi
        for test in "$hook_dir"/test-*.sh; do
            [ -f "$test" ] || continue
            if ! output=$(unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
                GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_CEILING_DIRECTORIES GIT_PREFIX
                bash "$test" 2>&1); then
                echo "$(basename "$test") failed:"
                echo "$output"
                [ "$guard_active" -eq 1 ] && rm -rf "$guard_dir"
                exit 1
            fi
        done
        if [ "$guard_active" -eq 1 ]; then
            desk_test_config_guard_snapshot "$guard_dir" after
            desk_test_state_guard_snapshot "$guard_dir" after
            guard_tripped=0
            if ! desk_test_config_guard_check "$guard_dir" before after; then
                echo "pre-commit: a test-*.sh run changed a guarded repo's local git config — aborting the commit"
                guard_tripped=1
            fi
            if ! desk_test_state_guard_check "$guard_dir" before after; then
                echo "pre-commit: a test-*.sh run touched real ~/.local/state/claude or ~/.local/state/desk — aborting the commit"
                guard_tripped=1
            fi
            rm -rf "$guard_dir"
            [ "$guard_tripped" -eq 0 ] || exit 1
        fi
    fi
fi

# Syntax-check staged Lua. The Hammerspoon config only ever runs on the Mac, so
# a typo committed from the Linux side surfaces as a silently dead config hours
# later. Parse-only, so hs.* calls that exist nowhere else are fine. Skipped
# where no luac is installed rather than failing the commit.
luac_bin="$(command -v luac5.4 || command -v luac || true)"
if [ -n "$luac_bin" ]; then
    while IFS= read -r f; do
        [ -n "$f" ] && [ -f "$f" ] || continue
        if ! output=$("$luac_bin" -p "$f" 2>&1); then
            echo "lua syntax error in $f:"
            echo "$output"
            exit 1
        fi
    done <<< "$(git diff --cached --name-only --diff-filter=ACM | grep '\.lua$')"
fi

# Delegate to pre-commit framework if installed and repo has config
if [ -f .pre-commit-config.yaml ] && command -v pre-commit &>/dev/null; then
    pre-commit run --hook-stage pre-commit "$@"
fi
