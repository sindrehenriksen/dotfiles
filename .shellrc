#### General
export VISUAL=nvim
export EDITOR="$VISUAL"
export LANG=en_US.UTF-8
# rg reads no config file unless told where one is. What it holds and why:
# ~/dotfiles/ripgrep/ripgreprc.
export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"
# What a NEW Claude Code session starts on. Deliberately not the `model` key in
# settings.json: /model writes that key when you press Enter in its picker, so
# the tracked config would change every time a session switched model. This
# variable is only consulted when no `model` key exists — press `s` in the
# picker to switch for the session alone and leave it that way.
export ANTHROPIC_DEFAULT_MODEL="opus[1m]"

# Platform detection
if [[ "$(uname)" == "Darwin" ]]; then
    IS_MAC=true
else
    IS_MAC=false
fi

# PATH - user local bin
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi



#### brew (macOS only)
# shellenv is already evaluated in .zprofile for zsh; this covers bash and any
# case where HOMEBREW_PREFIX isn't set yet. Apple Silicon path first, Intel
# fallback.
if $IS_MAC; then
    alias new-brew='eval "$(/opt/homebrew/bin/brew shellenv)"'
    alias old-brew='eval "$(/usr/local/bin/brew shellenv)"'
    if [ -z "$HOMEBREW_PREFIX" ]; then
        if [ -x /opt/homebrew/bin/brew ]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        elif [ -x /usr/local/bin/brew ]; then
            eval "$(/usr/local/bin/brew shellenv)"
        fi
    fi
fi


#### Machine-local early config
# Untracked drop-in for anything that has to run before the mise block below —
# typically because it exports MISE_TRUSTED_CONFIG_PATHS, and `mise activate`
# calls hook-env immediately, which hard-errors on an untrusted config in cwd's
# chain. Sourced later, a login shell in an untrusted dir greets you with mise
# trust errors, while a nested shell stays quiet — it inherits the var. Keep
# this above.
[ -f ~/.shellrc.early ] && source ~/.shellrc.early


#### mise
if command -v mise &>/dev/null; then
    eval "$(mise activate -s zsh)"
fi


#### Helper functions
# Check if the given command is available for gradual degradation purposes
function command_exists() {
    if ! hash "${1}" &>/dev/null
    then
        return 1
    fi
    return 0
}


rgr() {
    rg $1 --files-with-matches | xargs perl -i -pe"s/$1/$2/g"
}


#### Clipboard helpers (cross-platform)
if $IS_MAC; then
    # pbcopy/pbpaste are native on macOS
    :
else
    if command_exists wl-copy; then
        alias pbcopy='wl-copy'
        alias pbpaste='wl-paste'
    elif command_exists xclip; then
        alias pbcopy='xclip -selection clipboard'
        alias pbpaste='xclip -selection clipboard -o'
    elif command_exists xsel; then
        alias pbcopy='xsel --clipboard --input'
        alias pbpaste='xsel --clipboard --output'
    fi
fi


#### Aliases
alias v="nvim"
alias vim="nvim"
alias g="git"
alias c="clear"
#alias wc="watch --color "
alias mv="mv -i"

# Trash alias (platform-aware)
if $IS_MAC; then
    alias del="mv -t ~/.Trash/"
else
    alias del="gio trash"
    # Rewake internal keyboard if it dies after resume (Lenovo)
    alias kbr='sudo sh -c "echo -n rescan > /sys/devices/platform/i8042/serio0/drvctl"'
fi

alias gbcp="git branch | grep '^\*' | cut -d ' ' -f 2 | tr -d '\n' | pbcopy"
# Rebase onto updated main (taking into account that main upstream may be "main")
alias grbm='gbcp ; git checkout main ; git pull ; git checkout $(pbpaste) ; git rebase main'
alias grbmi='gbcp ; git checkout main ; git pull ; git checkout $(pbpaste) ; git rebase -i main'

# Open a diff in nvim's Diffview. Defaults to the branch's own changes.
gdv() {
    nvim -c "DiffviewOpen ${1:-origin/main...HEAD}"
}

# Github copilot
alias gc="gh copilot"
alias gce="gh copilot explain"
alias gcs="gh copilot suggest"

# Use eza as replacement for ls if available
if command_exists eza; then
    alias ls='eza --classify=auto --group-directories-first'
    alias ll='eza -l --classify=auto --group-directories-first'
    alias la='eza -al --classify=auto --group-directories-first'
else
    if [ -x /usr/bin/dircolors ]; then
        test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
        alias ls='ls -F --group-directories-first --color=auto'
        alias ll='ls -lF --group-directories-first --color=auto'
        alias la='ls -AlF --group-directories-first --color=auto'
    else
        alias ls='ls -F --group-directories-first'
        alias ll='ls -lF --group-directories-first'
        alias la='ls -AlF --group-directories-first'
    fi
fi


#### Claude Code account switcher
# Default account is personal. Override per machine with DEFAULT_ACCOUNT=work
# in ~/.shellrc.early (untracked) to flip every account-aware tool at once, or
# CLAUDE_DEFAULT_ACCOUNT=work for just this one.
# Explicit: claude-personal, claude-work. Each account uses its own config dir,
# which means MCP servers registered via `claude mcp add` are per-account —
# register work MCPs with `claude-work mcp add`, personal ones with `claude`.
# Also exports GH_CONFIG_DIR so `gh` inside the Claude session targets the
# matching account (Claude's Bash tool runs non-interactively and doesn't load
# the gh-* shell functions below).
#
# CLAUDE_PERSONAL_SETTINGS / CLAUDE_WORK_SETTINGS (set in ~/.shellrc.early) name
# an extra settings file for one account, passed as --settings. That is the only
# scope besides the config dir's own settings.json that may carry an autoMode
# block — project and local settings are ignored for it, deliberately, since a
# repo could otherwise hand itself classifier rules. Its autoMode allow,
# soft_deny and environment entries are appended to the ones here rather than
# replacing them, which is what lets an account keep its context out of this
# repo without restating the shared half.
_claude-run() {
    local account=$1; shift
    local dir=~/.claude
    local extra=$CLAUDE_PERSONAL_SETTINGS
    if [ "$account" = work ]; then
        dir=~/.claude-work
        extra=$CLAUDE_WORK_SETTINGS
    fi
    [ -n "$extra" ] && set -- --settings "$extra" "$@"
    echo "[claude] using ${account} account" >&2
    # CLAUDE_CODE_NO_FLICKER=1 enables alt-screen rendering so the input stays
    # pinned and scrolling doesn't snap to bottom. Upstream's accepted answer
    # for anthropics/claude-code#13591 — also reachable via `/tui fullscreen`.
    CLAUDE_CODE_NO_FLICKER=1 \
        CLAUDE_CONFIG_DIR="$dir" \
        GH_CONFIG_DIR=~/.config/gh-"$account" \
        command claude "$@"
}
claude()          { _claude-run "${CLAUDE_DEFAULT_ACCOUNT:-${DEFAULT_ACCOUNT:-personal}}" "$@"; }
claude-personal() { _claude-run personal "$@"; }
claude-work()     { _claude-run work "$@"; }


#### gh CLI account switcher
# Mirrors the claude switcher: per-process GH_CONFIG_DIR keeps concurrent
# sessions isolated. One-time setup per account:
#   gh-personal auth login
#   gh-work auth login
# Auto-injects --insecure-storage on `auth login`/`auth refresh` so tokens
# land in each dir's hosts.yml. The system keyring is keyed by host only, so
# without per-dir file storage two accounts collide on one keyring entry and
# the last write wins (silent breakage — gh auth status reads the user label
# from hosts.yml, not the actual token). Use `command gh ...` to bypass.
# Helpers use a double-underscore prefix, not single: Claude Code's shell
# snapshot strips every single-`_` function (the zsh completion convention,
# ~1100 of them) but keeps `__`-prefixed ones, so single-`_` helpers would be
# missing inside Claude's non-interactive shell and the `gh` wrapper below
# would fail with "command not found: _gh-exec".
__gh-exec() {
    if [ "$1" = auth ] && { [ "$2" = login ] || [ "$2" = refresh ]; }; then
        case " $* " in
            *' --insecure-storage '*) ;;
            *) set -- "$@" --insecure-storage ;;
        esac
    fi
    command gh "$@"
}
__gh-run() {
    local account=$1; shift
    GH_CONFIG_DIR=~/.config/gh-"$account" __gh-exec "$@"
}
# Bare `gh`: honor an explicitly-set GH_CONFIG_DIR (so claude-* exports and
# `GH_CONFIG_DIR=... gh ...` command-line prefixes win), otherwise pick by
# $GH_DEFAULT_ACCOUNT, then the shared $DEFAULT_ACCOUNT. The explicit forms
# below always force their account.
gh() {
    if [ -n "$GH_CONFIG_DIR" ]; then
        __gh-exec "$@"
    else
        __gh-run "${GH_DEFAULT_ACCOUNT:-${DEFAULT_ACCOUNT:-personal}}" "$@"
    fi
}
gh-personal() { __gh-run personal "$@"; }
gh-work()     { __gh-run work "$@"; }


#### Secrets (not tracked in dotfiles)
[ -f ~/.secrets.env ] && source ~/.secrets.env
