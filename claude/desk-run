#!/usr/bin/env bash
# The desk runner: `desk-run <pass>`, the one
# entry point the plists call (installed as a symlink at
# ~/.local/bin/desk-run, onto this file). Reads
# $DESK_CONFIG, runs the named pass's step list against the generic step
# kinds in claude/desk-lib/steps.sh, and writes the status file every
# other desk piece reads.
#
# What this file itself owns: argument/config parsing, the weekday filter,
# the guard/lock/stale-running sequence, the step loop and its status
# bookkeeping, and cleanup. Everything else (git/ledger/proposal writes,
# the model-call wrapper, timeouts, locking, status I/O, step-kind bodies)
# lives in claude/desk-lib/*.sh, sourced below — a test can source those
# directly without going through this file at all.
#
# Setup, the config schema and the prompt contract: docs/desk.md.
set -u

# Resolve this file's own directory through any symlink (so
# ~/.local/bin/desk-run -> this file still finds claude/desk-lib/*.sh),
# same technique as claude/desk-lib/common.sh's own desk_lib_dir.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
	_dir="$(cd -P "$(dirname "$_src")" && pwd)"
	_src="$(readlink "$_src")"
	[[ "$_src" != /* ]] && _src="$_dir/$_src"
done
DESK_RUN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"

# shellcheck source=desk-lib/common.sh
source "$DESK_RUN_DIR/desk-lib/common.sh"
source "$DESK_RUN_DIR/desk-lib/lock.sh"
source "$DESK_RUN_DIR/desk-lib/status.sh"
source "$DESK_RUN_DIR/desk-lib/timeout.sh"
source "$DESK_RUN_DIR/desk-lib/model-call.sh"
source "$DESK_RUN_DIR/desk-lib/git-ops.sh"
source "$DESK_RUN_DIR/desk-lib/tool-results.sh"
source "$DESK_RUN_DIR/desk-lib/validate.sh"
source "$DESK_RUN_DIR/desk-lib/ticket-cache.sh"
source "$DESK_RUN_DIR/desk-lib/steps.sh"

pass="${1:-}"
if [ -z "$pass" ]; then
	echo "usage: desk-run <pass>" >&2
	exit 2
fi

DESK_CONFIG="${DESK_CONFIG:-}"
if [ -z "$DESK_CONFIG" ]; then
	desk_log "$pass" '$DESK_CONFIG is not set'
	exit 2
fi
if [ ! -f "$DESK_CONFIG" ]; then
	desk_log "$pass" "config file not found: $DESK_CONFIG"
	exit 2
fi
config="$(cat "$DESK_CONFIG")"
if ! jq -e . > /dev/null 2>&1 <<< "$config"; then
	desk_log "$pass" "\$DESK_CONFIG is not valid JSON: $DESK_CONFIG"
	exit 2
fi

pass_config="$(jq -c --arg p "$pass" '.passes[$p] // empty' <<< "$config")"
if [ -z "$pass_config" ]; then
	desk_log "$pass" "unknown pass (no .passes.$pass in \$DESK_CONFIG)"
	exit 2
fi

# Generic ids: dotfiles is public and names no instantiation-specific fact
# of any kind, which extends to the exact MCP tool names an
# instantiation's own connectors happen to expose, the step ids it
# special-cases for ticket status and mail, and his own timezone — none of
# those are guessable defaults this repo can ship, so every one is a
# required $DESK_CONFIG field, failing loudly (never a silent fallback to
# a work-specific literal) when absent.
timezone="$(jq -r '.timezone // empty' <<< "$config")"
ticket_search_tool="$(jq -r '.ticket_search_tool // empty' <<< "$config")"
mail_search_tool="$(jq -r '.mail_search_tool // empty' <<< "$config")"
ticket_status_step_id="$(jq -r '.ticket_status_step_id // empty' <<< "$config")"
mail_fetch_step_id="$(jq -r '.mail_fetch_step_id // empty' <<< "$config")"
for required_field in timezone ticket_search_tool mail_search_tool ticket_status_step_id mail_fetch_step_id; do
	if [ -z "${!required_field}" ]; then
		desk_log "$pass" "\$DESK_CONFIG is missing required field \"$required_field\" (no work-specific default is shipped here)"
		exit 2
	fi
done

# Weekdays only for morning/16:30's own MODEL steps — but commit-and-push runs every day, weekends included:
# a weekend still deserves whatever his own text picked up committed (and
# pushed, once push_enabled) even though nothing is calling a model.
# Checked against the step loop below rather than a whole-pass early exit,
# so a weekend invocation still takes the lock, runs the once-a-day guard,
# and does the commit_push step; only the model-calling step kinds are
# skipped.
# The pass's own `weekdays_only` says so; absent, the names `morning` and
# `1630` keep their historical default of true, every other name false.
case "$pass" in
	morning | 1630) weekday_default="true" ;;
	*) weekday_default="false" ;;
esac
weekday_only_pass="$(jq -r --arg d "$weekday_default" 'if .weekdays_only == null then $d else (.weekdays_only | tostring) end' <<< "$pass_config")"
is_weekend="false"
dow="$(date +%u)" # 1=Mon .. 7=Sun
[ "$dow" -ge 6 ] && is_weekend="true"

# One lock, shared across every pass (lock.sh's own DESK_LOCK_NAME): morning
# and 16:30 both touch the same notes repo, ledger and status.json, so they
# must never run at once regardless of which pass name invoked this — a
# per-pass lock would let exactly that race happen. Taken before anything
# else touches status.json, the once-a-day guard check included, so a
# concurrent invocation waits (or gives up) rather than racing the guard's
# own read against another invocation's write, or racing
# desk_status_mark_stale_running's own read-modify-write.
lockdir="$(desk_lock_acquire "$pass")"
if [ -z "$lockdir" ]; then
	desk_log "$pass" "gave up waiting for the lock"
	desk_status_bump lockouts
	exit 1
fi

PASS_SCRATCH=""
cleanup() {
	desk_lock_release
	[ -n "$PASS_SCRATCH" ] && rm -rf "$PASS_SCRATCH" 2> /dev/null
}
trap cleanup EXIT

# A previous invocation that never finished shows as failed rather than
# silently vanishing under this one's fresh "running" (a "running" entry older
# than the stale threshold shows as failed).
desk_status_mark_stale_running "$pass"

# The guard is keyed on (pass, the slot's scheduled date), not the date
# desk-run happens to run on: a
# pass's own `.trigger.start_calendar_interval` (the plist's own slot list,
# mirrored into $DESK_CONFIG since desk-run never reads a plist directly)
# says which slots exist; an unconfigured pass (no trigger, as every test
# fixture and the weekly pass are) falls back to today's date, so this is a
# no-op for anything not yet wired to a trigger.
slots_json="$(jq -c '.trigger.start_calendar_interval // []' <<< "$pass_config")"
scheduled_date="$(desk_scheduled_date_for "$slots_json")"

# The once-a-day guard: a slot firing after this scheduled date's pass
# already finished ok is a no-op.
if desk_guard_already_ok_today "$pass" "$scheduled_date"; then
	desk_log "$pass" "already ok today (scheduled $scheduled_date): no-op"
	exit 0
fi

PASS_SCRATCH="$(desk_scratch_dir "$pass-pass")"

# The deny hook every connector/scoped-Read call this pass makes is wired
# to (model-call.sh's own desk_write_deny_hook_settings) points at THIS
# copy, never straight at $DESK_LIB_DIR/deny-unlisted-tool.sh — a long
# pass shouldn't have its own safety net depend on that repo file staying
# exactly as it is (or staying present at all) for the pass's own
# duration; a mid-run `git pull` of this repo, or anything else that
# touches it, must never leave an in-flight call's already-written hook
# `command` pointing at something changed out from under it. Refusing the
# whole pass when the copy itself fails is the same "fails closed" the
# hook script's own missing-file paths already apply to a *call*, one
# level up: no copy means no pass, never a pass whose every call quietly
# ran without this layer.
DESK_DENY_HOOK_SCRIPT="$PASS_SCRATCH/deny-unlisted-tool.sh"
if ! cp "$DESK_LIB_DIR/deny-unlisted-tool.sh" "$DESK_DENY_HOOK_SCRIPT" 2> /dev/null; then
	desk_log "$pass" "couldn't copy deny-unlisted-tool.sh into this pass's own scratch — refusing (a missing hook script must fail closed)"
	exit 2
fi
export DESK_DENY_HOOK_SCRIPT

# Visible run sessions:
# sweep any $DESK_RUNS_ROOT/<pass>-<date> directory (and its config-dir
# project folder) more than 7 days old, before this run creates its own —
# never after, which would sweep the one this same invocation is about to
# use. `follow_up_step` (this pass's own config, absent for anything not
# yet wired to it) is resolved into an actual tab once the pass is done,
# below.
desk_prune_old_runs
follow_up_step="$(jq -r '.follow_up_step // empty' <<< "$pass_config")"

# A fixed lookback window for F-private's Gmail queries (epoch
# after:/before: bounds): since this pass's own last successful run,
# or a config-configurable default when there's never been one. Computed
# before desk_status_set_running overwrites that "ok" record with this
# run's own "running" one, and before this pass ever runs a fetch step,
# since W (later in the same pass) has to re-check the exact query
# F-private actually ran against this same value — "the runner checks the
# query it ran" means checking it against what the runner
# itself told F-private to run, not a value re-derived after the fact.
gmail_window_end="$(desk_now)"
gmail_window_lookback="$(jq -r '.gmail_window_lookback_secs // 172800' <<< "$config")"
last_ok="$(desk_status_last_ok_run "$pass")"
# The window's own floor is last_fetch_ok, NOT last_ok_run: a weekend
# commit-only invocation of a weekday_only_pass still finishes "ok" (the
# commit_push step succeeds, no model step ever ran to skip), which would
# advance last_ok_run and silently narrow the next weekday's own lookback
# past mail/Slack the weekend itself never actually fetched. last_fetch_ok
# only ever moves forward when a fetch step of THIS pass actually ran and
# none failed (see the "nothing left to retry" branch below).
last_fetch_ok="$(desk_status_last_fetch_ok "$pass")"
if [ -n "$last_fetch_ok" ]; then
	gmail_window_start="$last_fetch_ok"
else
	gmail_window_start=$((gmail_window_end - gmail_window_lookback))
fi
# The digest label is instantiation-specific data, so it's a config field, never a
# literal here — an instantiation with no digest source configured still
# gets valid (if pointless) JQL-shaped Gmail syntax rather than an error.
digest_label="$(jq -r '.digest_gmail_label // "Digest"' <<< "$config")"
digest_query="label:\"${digest_label}\" after:${gmail_window_start} before:${gmail_window_end}"
inbox_query="in:inbox after:${gmail_window_start} before:${gmail_window_end}"

desk_status_set_running "$pass"

repo="$(jq -r '.notes_repo' <<< "$config")"
repo="${repo/#\~/$HOME}"
# notes_repo must be an absolute path that IS some repo's own toplevel —
# never a relative path (which would resolve against whatever cwd launchd
# or a shell happened to invoke desk-run from, not $DESK_CONFIG's own
# intent), a subdirectory of a repo, or a string that isn't a git repo at
# all: every step below runs `git -C "$repo" ...` trusting this points at
# exactly the repo whose HEAD/branch/notes files it's about to commit to
# and push. A worktree's own root still passes (--show-toplevel names the
# CURRENT worktree, never the main checkout's), so this only refuses a
# strict subdirectory or a non-repo path. Compared as physically resolved
# paths (symlinks and all followed) on both sides, never the raw config
# string against git's own (always-resolved) answer — a config path that
# happens to cross a symlink (e.g. a home directory itself mounted through
# one) would otherwise refuse a perfectly legitimate toplevel.
case "$repo" in
	/*) : ;;
	*)
		desk_log "$pass" "notes_repo must be an absolute path: $repo"
		exit 2
		;;
esac
repo_resolved="$(cd -P "$repo" 2> /dev/null && pwd -P)"
if [ -z "$repo_resolved" ]; then
	desk_log "$pass" "notes_repo ($repo) doesn't exist — refusing"
	exit 2
fi
repo_toplevel="$(git -C "$repo_resolved" rev-parse --show-toplevel 2> /dev/null)"
if [ "$repo_toplevel" != "$repo_resolved" ]; then
	desk_log "$pass" "notes_repo ($repo) is not a git repo's own toplevel (got: ${repo_toplevel:-<not a git repo>}) — refusing"
	exit 2
fi
repo="$repo_resolved"
mapfile -t files < <(jq -r '.files[]' <<< "$config")
# Where capture items land: `captures_file`,
# default the first configured file.
DESK_CAPTURES_FILE="$(jq -r --arg d "${files[0]:-notes.md}" '.captures_file // $d' <<< "$config")"
export DESK_CAPTURES_FILE
# NOT `.push_enabled // false`: see the dry_run/log_only comments
# elsewhere in this file on why jq's `//` can't be used for a boolean
# whose explicit "false" is meaningful — here that's moot (false already
# is the default), but it's the same spelling everywhere a config boolean
# is read, so a later "flip the default" edit never silently breaks this
# one from having used the shorter form instead.
push_enabled="$(jq -r 'if .push_enabled == true then "true" else "false" end' <<< "$config")"
export DESK_CONFIG
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

# The scalar context every call gets a share of: a generous superset computed once per pass, never
# gated per step — desk_render_prompt only ever substitutes a {{name}} a
# prompt's own text actually references, so an unused key here costs
# nothing ("the runner knows how to produce each kind"). `mode` uses
# `last_ok` (this pass's own last "ok" run, already captured above, before
# desk_status_set_running overwrote it) rather than re-reading it now.
mode="$(desk_compute_mode "$last_ok")"
today="$(date +%F)"
window_start_iso="$(desk_iso8601_at_tz "$gmail_window_start" "$timezone")"
window_end_iso="$(desk_iso8601_at_tz "$gmail_window_end" "$timezone")"
# The morning pass's one source definition. Its actual name is instantiation-specific data, same
# reasoning as digest_gmail_label above — a config field, never a literal
# here — so an instantiation with no `sources_file` configured still gets a
# valid (if empty) sources placeholder rather than an error.
sources_rel="$(jq -r '.sources_file // "sources.json"' <<< "$config")"
sources_path="$(desk_prompt_path "$sources_rel")"
sources_content="$(cat "$sources_path" 2> /dev/null)"
[ -n "$sources_content" ] || sources_content='{}'
common_placeholders="$(jq -n \
	--arg mode "$mode" --arg today "$today" \
	--arg window_start "$window_start_iso" --arg window_end "$window_end_iso" \
	--arg digest_query "$digest_query" --arg inbox_query "$inbox_query" \
	--arg slack_oldest "$gmail_window_start" --arg slack_latest "$gmail_window_end" \
	--arg sources "$sources_content" '{
		mode: $mode, today: $today, window_start: $window_start, window_end: $window_end,
		digest_query: $digest_query, inbox_query: $inbox_query,
		slack_oldest: $slack_oldest, slack_latest: $slack_latest, sources: $sources
	}')"

# The file-producing context (desk-lib/steps.sh's desk_seed_named_file):
# `old_ticket_cache` is read now, before T's own fetch step (later in this
# same pass's step list) overwrites $DESK_TICKET_CACHE — J's tickets.json
# is a diff against exactly this snapshot, never a value re-derived after
# the fact.
old_ticket_cache="$(cat "$DESK_TICKET_CACHE" 2> /dev/null)"
[ -n "$old_ticket_cache" ] || old_ticket_cache='{}'
jq -e . > /dev/null 2>&1 <<< "$old_ticket_cache" || old_ticket_cache='{}'
pass_ctx="$(jq -n --arg repo "$repo" --arg sources_path "$sources_path" --arg pass_scratch "$PASS_SCRATCH" \
	--arg scheduled_date "$scheduled_date" --argjson old_ticket_cache "$old_ticket_cache" \
	--arg mail_fetch_step_id "$mail_fetch_step_id" '{
		repo: $repo, sources_path: $sources_path, pass_scratch: $pass_scratch,
		scheduled_date: $scheduled_date, old_ticket_cache: $old_ticket_cache,
		mail_fetch_step_id: $mail_fetch_step_id
	}')"

overall_result="ok"
stopped_at=""
# Source (fetch) steps get their own failure mode: recorded here, never
# aborting the pass outright (a later slot retries only the
# missing sources — see steps.sh's desk_fetch_cache_* for the same-day
# cache that makes an already-succeeded source skip a redundant re-run
# rather than this array growing to include it again).
failed_sources=()
# Whether any fetch step of THIS pass actually ran (as opposed to being
# skipped by the weekday_only_pass/weekend guard above) — desk_status_
# set_fetch_ok only ever advances the window when this is true, so a
# weekend commit-only run of morning/1630 never moves it.
any_fetch_step_ran="false"
# The judge branch below fills this in from its own {kept, overflow}
# result; a pass with no judge step this run (a close-only 16:30, a
# commit_push-only pass) reports no overflow, matching status.lua's own
# "only shown when actually nonzero" gate.
proposal_overflow_json='{"act": 0, "worth_knowing": 0, "wildcard": 0}'

steps_len="$(jq '.steps | length' <<< "$pass_config")"
for ((i = 0; i < steps_len; i++)); do
	step_json="$(jq -c ".steps[$i]" <<< "$pass_config")"
	id="$(jq -r '.id' <<< "$step_json")"
	kind="$(jq -r '.kind' <<< "$step_json")"

	if [ "$weekday_only_pass" = "true" ] && [ "$is_weekend" = "true" ] && [ "$kind" != "commit_push" ]; then
		desk_log "$pass" "step $id ($kind): skipped (weekend — model steps run weekdays only)"
		continue
	fi

	result="failed"
	case "$kind" in
		commit_push) result="$(desk_step_commit_push_kind "$repo" "$push_enabled" "${files[@]}")" ;;

		fetch)
			any_fetch_step_ran="true"
			if desk_fetch_already_done "$pass" "$scheduled_date" "$id"; then
				desk_fetch_cache_restore "$pass" "$scheduled_date" "$id"
				result="ok"
				desk_log "$pass" "fetch $id: already fetched today (cached) — reusing, no re-run"
				# The cached call ran with an EARLIER slot's own
				# gmail_window_end, baked into the digest_query its own
				# prompt actually used — never this run's freshly computed
				# one. W's own later match (below) is against exactly what
				# that call's tool_use asked for, so digest_query has to
				# track the cached call, not "now", for the rest of this
				# run. Empty (an older cache entry, saved before this
				# existed) leaves digest_query as this run's own value,
				# same as before.
				if [ "$id" = "$mail_fetch_step_id" ]; then
					cached_digest_query="$(desk_fetch_cache_digest_query "$pass" "$scheduled_date" "$id")"
					[ -n "$cached_digest_query" ] && digest_query="$cached_digest_query"
				fi
			else
				placeholders="$common_placeholders"
				if [ "$id" = "$ticket_status_step_id" ]; then
					notes_text=""
					for f in "${files[@]}"; do
						notes_text="$notes_text
$(git -C "$repo" show "HEAD:$f" 2> /dev/null)"
					done
					tokens_json="$(jq -c '.tokens // []' <<< "$config")"
					jql="$(desk_build_jql "$notes_text" "$tokens_json")"
					placeholders="$(jq -c --arg jql "$jql" '. + {jql: $jql}' <<< "$common_placeholders")"
				fi
				result="$(desk_step_fetch "$pass" "$step_json" "" "$placeholders" "" "" "$scheduled_date")"
				if [ "$result" = "ok" ]; then
					desk_fetch_cache_save "$pass" "$scheduled_date" "$id" "$digest_query"
				fi
			fi
			if [ "$id" = "$ticket_status_step_id" ] && [ "$result" = "ok" ]; then
				desk_build_ticket_cache "$PASS_SCRATCH/${id}-tool-uses.jsonl" "$PASS_SCRATCH/${id}-tool-results.jsonl" \
					"$ticket_search_tool" > /dev/null \
					|| desk_log "$pass" "$id: ticket cache parse failed, old cache kept"
			fi
			if [ "$result" != "ok" ]; then
				# A source's own failure is never fatal to the pass (a
				# "partial proposal"): recorded, logged, and the loop carries
				# on with whatever other sources/J/W/close still have to say —
				# never marked done for this scheduled date, so a later slot
				# retries exactly this (and only this) source.
				failed_sources+=("$id")
				desk_log "$pass" "step $id ($kind): $result (a source failure — pass continues, flagged partial)"
				continue
			fi
			;;

		judge)
			# The pass's own `caps` names which entry of the top-level `caps`
			# table it uses; absent, a pass named `weekly` uses "weekly",
			# every other pass "daily".
			caps_default="daily"
			[ "$pass" = "weekly" ] && caps_default="weekly"
			caps_key="$(jq -r --arg d "$caps_default" '.caps // $d' <<< "$pass_config")"
			caps_json="$(jq -c --arg k "$caps_key" '.caps[$k] // {}' <<< "$config")"
			caps_str="$(desk_caps_string "$caps_json")"
			judge_placeholders="$(jq -c --arg caps "$caps_str" '. + {caps: $caps}' <<< "$common_placeholders")"
			result="$(desk_step_judge "$pass" "$step_json" "$repo" "$judge_placeholders" "$pass_ctx" "${files[@]}")"
			if [ "$result" = "ok" ]; then
				final_text="$(desk_extract_final_text "$PASS_SCRATCH/${id}-stream.jsonl")"
				items_json="$(jq -c 'if type == "object" and has("items") then .items else . end' \
					<<< "$final_text" 2> /dev/null)"
				# NOT just "is items_json valid JSON": a scalar reply (a bare
				# string/number, or an object with no "items" key) passes
				# `jq -e .` just fine while being nowhere near the pinned
				# {"items": [...]} shape — the actual schema check is "is an
				# array", the one shape every downstream step (validate/caps/
				# staging) assumes without re-checking. An unparseable or
				# schema-invalid reply here is a loud failure (not just a log
				# line): no W runs after a J whose reply couldn't be trusted,
				# and the pass is never marked done, so a retry slot re-runs it
				# instead of silently treating "nothing staged" as success.
				if [ -z "$items_json" ] || ! jq -e 'type == "array"' > /dev/null 2>&1 <<< "$items_json"; then
					desk_log "$pass" "judge $id: reply wasn't the pinned {\"items\": [...]} shape — failing the pass"
					result="failed"
				else
					# Only the FETCH steps' own raw tool-results ever seed
					# the allowed-URL set — never a blanket glob over every
					# *-tool-results.jsonl in the scratch dir, which would
					# also sweep up J's own (this judge call's own tool
					# calls, e.g. a Read of notes.md/f-private.json, can
					# themselves surface a source's own quoted text or the
					# model's own prose, never something a real fetch call
					# actually retrieved). The whole point of this set is
					# "verifiably came from a fetch", so it's built from
					# exactly this pass's own fetch step ids, not from
					# whatever files happen to sit in the scratch dir.
					mapfile -t fetch_ids < <(jq -r '.steps[] | select(.kind == "fetch") | .id' <<< "$pass_config")
					results_files=()
					for fetch_id in "${fetch_ids[@]}"; do
						f="$PASS_SCRATCH/${fetch_id}-tool-results.jsonl"
						[ -f "$f" ] && results_files+=("$f")
					done
					workspace_url="$(jq -r '.slack_workspace_url // empty' <<< "$config")"
					allowed_urls="$(desk_allowed_urls "$workspace_url" "${results_files[@]}")"
					validated_json="$(desk_validate_items "$items_json" "$allowed_urls")"
					capped="$(desk_apply_caps "$validated_json" "$caps_json" "$pass")"
					kept_json="$(jq -c '.kept' <<< "$capped")"
					# This judge call's own overflow-by-tier — status.json's
					# `proposal.overflow` (nvim/lua/desk/status.lua's own
					# reader) — captured here since `capped` (desk_apply_caps's
					# own {kept, overflow} pair) only exists in this branch's
					# own scope; the end-of-pass status write below reads it
					# back out of this variable.
					proposal_overflow_json="$(jq -c '
						{act: 0, worth_knowing: 0, wildcard: 0}
						+ ([.overflow[] | .tier] | group_by(.) | map({(.[0]): length}) | add // {})
					' <<< "$capped")"
					items_file="$PASS_SCRATCH/${id}-validated-items.json"
					jq -n --argjson items "$kept_json" '{items: $items}' > "$items_file"
					if ! desk_stage_and_write_proposal "$repo" "$pass" "$scheduled_date" "$items_file" "${files[@]}" > /dev/null; then
						desk_log "$pass" "judge $id: staging the proposal failed"
						result="failed"
					fi
				fi
			fi
			;;

		write)
			# The pinning below applies by step KIND (the write step is the
			# one unattended external write, one per pass by
			# construction), never by checking this step's own `id`
			# against a hardcoded literal: an instantiation is free to
			# call it whatever it likes, and a check keyed on a literal
			# id would silently stop enforcing the pinned-args safety net
			# the moment someone renamed the step in config, with nothing
			# to say so.
			pinned_args_json="null"
			placeholders="$common_placeholders"
			# This write step's own thread ids only ever come from the
			# configured mail-fetch step's own search (never re-derived,
			# per the check below). If that step itself is a failed source
			# this pass, there's no real "fetched" set to unlabel against
			# at all — proceeding would silently unlabel zero ids and
			# report "ok", which reads as "nothing to do" rather than "the
			# source it depends on never ran". Fail loudly instead
			# (the write step asserts that what it unlabels is what was fetched).
			mail_fetch_failed="false"
			for fs in "${failed_sources[@]:-}"; do
				[ "$fs" = "$mail_fetch_step_id" ] && mail_fetch_failed="true"
			done
			if [ "$mail_fetch_failed" = "true" ]; then
				desk_log "$pass" "$id: $mail_fetch_step_id (the source it unlabels against) failed this pass — refusing to unlabel"
				result="failed"
			else
				pairs="$(desk_tool_call_pairs "$PASS_SCRATCH/$mail_fetch_step_id-tool-uses.jsonl" \
					"$PASS_SCRATCH/$mail_fetch_step_id-tool-results.jsonl" "$mail_search_tool")"
				matching_pair="$(jq -c --arg q "$digest_query" \
					'[.[] | select(.input.query == $q)] | .[0] // empty' <<< "$pairs")"
				ids_subjects="[]"
				query_mismatch="false"
				if [ -n "$matching_pair" ]; then
					result_text="$(jq -r '.text' <<< "$matching_pair")"
					if jq -e . > /dev/null 2>&1 <<< "$result_text"; then
						ids_subjects="$(jq -c '[(.threads // [])[] | {id, subject: (.subject // .snippet // "unknown")}]' \
							<<< "$result_text")"
					fi
				else
					query_mismatch="true"
					desk_log "$pass" "$id: $mail_fetch_step_id's digest search query doesn't match the configured one — no ids pinned"
				fi
				n_ids="$(jq 'length' <<< "$ids_subjects")"
				while IFS=$'\t' read -r tid subj; do
					[ -n "$tid" ] || continue
					desk_log "$pass" "$id: would unlabel $tid ($subj)"
				done < <(jq -r '.[] | .id + "\t" + .subject' <<< "$ids_subjects")

				pinned_label="$(jq -r '.pinned_label // "UNREAD"' <<< "$step_json")"
				pinned_args_json="$(jq -c --arg l "$pinned_label" \
					'[.[] | {threadId: .id, labelIds: [$l]}]' <<< "$ids_subjects")"
				thread_ids_text="$(jq -r '.[].id' <<< "$ids_subjects")"
				placeholders="$(jq -c --arg t "$thread_ids_text" '. + {thread_ids: $t}' <<< "$common_placeholders")"

				# NOT `.dry_run // true`: jq's `//` treats a real `false`
				# as falsy too, so that spelling would silently ignore an
				# explicit `"dry_run": false` and always come back "true".
				dry_run="$(jq -r 'if .dry_run == null then true else .dry_run end' <<< "$config")"
				if [ "$query_mismatch" = "true" ]; then
					# An empty pinned set here means "the query never
					# matched anything to check", never "the query matched
					# and genuinely found nothing" — the two look identical
					# downstream (both hand W a `[]` pinned set) unless this
					# is called out on its own, and silently treating the
					# former as the latter would have W (or, in dry_run,
					# desk-run itself) report zero threads unlabelled on a
					# day $mail_fetch_step_id may well have had real ones,
					# with nothing else ever surfacing that. Fails the pass
					# regardless of dry_run — dry_run only ever skips the
					# model call, never this pass's own correctness check.
					desk_log "$pass" "$id: refusing — the digest query never matched, so an empty pinned set can't be trusted as \"genuinely nothing to unlabel\""
					result="failed"
				elif [ "$dry_run" = "true" ]; then
					desk_log "$pass" "$id: dry_run — logged $n_ids id(s), no model call made"
					result="ok"
				else
					result="$(desk_step_write "$pass" "$step_json" "$pinned_args_json" "$placeholders" "$scheduled_date")"
					# A count mismatch fails loudly:
					# the deny hook's own --pinned only ever stops W from
					# unlabelling something OUTSIDE the pinned set — it
					# can't tell "unlabelled all of them" from "unlabelled
					# only some, or none" (the model called the tool fewer
					# times than there were ids to act on, or not at all).
					# This is the other half: compare what the call's own
					# tool_use arguments actually named against the full
					# pinned set, after the fact, and fail loudly on any
					# mismatch — never silently treat "acted on some" as
					# "acted on all".
					if [ "$result" = "ok" ]; then
						write_tool="$(jq -r '(.tools // [])[0] // empty' <<< "$step_json")"
						actual_ids_text="$(jq -r --arg t "$write_tool" \
							'select(.name == $t) | .input.threadId // empty' \
							"$PASS_SCRATCH/${id}-tool-uses.jsonl" 2> /dev/null | sort -u)"
						pinned_ids_text="$(jq -r '.[].id' <<< "$ids_subjects" | sort -u)"
						if [ "$actual_ids_text" != "$pinned_ids_text" ]; then
							desk_log "$pass" "$id: unlabelled thread ids don't match the pinned set (W count mismatch) — failing the pass"
							result="failed"
						fi
					fi
				fi
			fi
			;;

		capture) result="$(desk_step_capture_sessions "$pass" "$repo" "$scheduled_date" "${files[@]}")" ;;
		close) result="$(desk_step_close "$pass" "$step_json" "$config" "$repo" "$scheduled_date" "${files[@]}")" ;;
		open_tab) result="$(desk_step_open_tab "$step_json" "$repo" "${files[@]}")" ;;
		*) desk_log "$pass" "unknown step kind: $kind (step $id)" ;;
	esac
	desk_log "$pass" "step $id ($kind): $result"

	case "$result" in
		failed | timeout | error)
			overall_result="failed"
			stopped_at="$id"
			break
			;;
	esac
done

# A source failure never broke the loop above (it `continue`s instead),
# so reaching here with the loop otherwise clean ("ok", not a harder
# failed/break from a later non-source step) but with sources still
# outstanding is exactly a "partial" pass: J still ran and staged
# whatever it could, flagged partial, but this scheduled date isn't fully
# done — a later slot retries the missing sources, per
# desk_guard_already_ok_today only ever treating "ok" as done.
failed_sources_json="[]"
if [ "${#failed_sources[@]}" -gt 0 ]; then
	failed_sources_json="$(printf '%s\n' "${failed_sources[@]}" | jq -R . | jq -s .)"
	[ "$overall_result" = "ok" ] && overall_result="partial"
elif [ "$overall_result" != "failed" ]; then
	# Nothing left to retry: the same-day fetch cache has done its job.
	# Gated on the PASS's own overall_result, not just on failed_sources
	# being empty: a later, non-source step (judge/write/close) can still
	# hard-fail and `break` the loop with every fetch itself having
	# succeeded — failed_sources stays empty in that case too, but the
	# pass as a whole did not finish, so clearing the cache here would
	# throw away a retry slot's one reason to skip re-running fetches that
	# already succeeded, and advancing last_fetch_ok would silently narrow
	# the next window past content this failed pass never actually got to
	# use.
	desk_fetch_cache_clear "$pass"
	# Every fetch step this pass actually ran (if any) succeeded: the
	# window is now covered through gmail_window_end (captured before any
	# step ran), so the next run's own window picks up exactly where this
	# one left off rather than re-covering (or gapping) any of it. Never
	# set at all when no fetch step ran this pass (a weekend commit-only
	# invocation) — last_fetch_ok stays wherever it last legitimately was.
	[ "$any_fetch_step_ran" = "true" ] && desk_status_set_fetch_ok "$pass" "$gmail_window_end"
fi

desk_status_set_result "$pass" "$overall_result" "$stopped_at" "$failed_sources_json" "$scheduled_date"

# Visible run sessions: opens once the pass is done, whatever its own
# result — a failed pass still opens the tab on whatever visible calls did
# get made.
desk_open_follow_up_tab "$pass" "$scheduled_date" "$follow_up_step" > /dev/null

# -----------------------------------------------------------------------
# The rest of status.json: proposal state/overflow/counts, the ticket cache's own age, and
# this pass's total spend. All read-only against the proposal and ledger
# refs and $DESK_TICKET_CACHE as they stand right now — none of it gates
# overall_result, so a failure computing any one of these never costs the
# pass its own already-decided result.
# -----------------------------------------------------------------------

# proposal: state ("partial" if this pass leaves any source failed,
# "pending" while any suggestion still waits on him — untaken, undeclined,
# applied — and "none" otherwise, from the CURRENT standing proposal, not
# just what this pass itself staged, since a pass with no judge step still
# has to report on whatever's already sitting there); overflow (this
# pass's own judge call, above, or the zero default); counts (by item kind
# and by tier, across the open items); untaken (how many there are).
proposal_open_json="$(desk_nvim_cli proposal-open "$repo" 2> /dev/null)"
proposal_items_n=0
proposal_counts_by_kind_json='{}'
proposal_counts_by_tier_json='{"act": 0, "worth_knowing": 0, "wildcard": 0}'
if [ -n "$proposal_open_json" ] && jq -e . > /dev/null 2>&1 <<< "$proposal_open_json"; then
	proposal_items_n="$(jq '.items | length' <<< "$proposal_open_json")"
	proposal_counts_by_kind_json="$(jq -c '[.items[].kind] | group_by(.) | map({(.[0]): length}) | add // {}' \
		<<< "$proposal_open_json")"
	proposal_counts_by_tier_json="$(jq -c '
		{act: 0, worth_knowing: 0, wildcard: 0}
		+ ([.items[] | select(.tier) | .tier] | group_by(.) | map({(.[0]): length}) | add // {})
	' <<< "$proposal_open_json")"
fi
proposal_partial="false"
proposal_state="none"
[ "$proposal_items_n" -gt 0 ] && proposal_state="pending"
if [ "${#failed_sources[@]}" -gt 0 ]; then
	proposal_partial="true"
	proposal_state="partial"
fi

proposal_json="$(jq -n \
	--arg state "$proposal_state" --argjson partial "$proposal_partial" \
	--argjson overflow "$proposal_overflow_json" \
	--argjson by_kind "$proposal_counts_by_kind_json" --argjson by_tier "$proposal_counts_by_tier_json" \
	--argjson untaken "$proposal_items_n" '{
		state: $state, partial: $partial, overflow: $overflow,
		counts: {by_kind: $by_kind, by_tier: $by_tier},
		untaken: $untaken
	}')"
desk_status_set_field proposal "$proposal_json"

# ticket_cache_age: how stale $DESK_TICKET_CACHE is right now, in seconds
# — never re-derived from whether T happened to run this particular pass,
# since the field means "how old is what I'd read right now", not
# "did this pass refresh it".
ticket_cache_age_json="null"
if [ -f "$DESK_TICKET_CACHE" ]; then
	ticket_checked_at="$(jq -r '.checked_at // empty' "$DESK_TICKET_CACHE" 2> /dev/null)"
	[ -n "$ticket_checked_at" ] && ticket_cache_age_json=$(($(desk_now) - ticket_checked_at))
fi
desk_status_set_field ticket_cache_age "$ticket_cache_age_json"

# total_cost_usd: every call this pass made (desk_step_model_call's own
# cost log, one number per line, fetch/judge/write/close-per-session
# calls alike), summed.
total_cost_usd_json="0"
if [ -f "$PASS_SCRATCH/.costs.log" ]; then
	total_cost_usd_json="$(jq -s 'add // 0' "$PASS_SCRATCH/.costs.log" 2> /dev/null || echo 0)"
fi
desk_status_update '.passes[$pass].total_cost_usd = $cost' --arg pass "$pass" --argjson cost "$total_cost_usd_json"

desk_log "$pass" "done: $overall_result${stopped_at:+ (stopped at $stopped_at)}"

[ "$overall_result" != "failed" ]
