#!/usr/bin/env bash
# The desk runner: `desk-run <pass> [--rerun]`, the entry point the schedule
# calls (installed as ~/.local/bin/desk-run). Reads $DESK_CONFIG, runs the
# pass's steps, writes the status file, and hands a pass with a brief to the
# central session (brief.sh). A follow pass runs on its own path
# (follow.sh). Setup, the config and the prompt contract: docs/desk.md.
set -u

# This file's own directory, through any symlink, so the installed link
# still finds desk-lib/.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
	_dir="$(cd -P "$(dirname "$_src")" && pwd)"
	_src="$(readlink "$_src")"
	[[ "$_src" != /* ]] && _src="$_dir/$_src"
done
DESK_RUN_DIR="$(cd -P "$(dirname "$_src")" && pwd)"

# shellcheck source=desk-lib/common.sh
source "$DESK_RUN_DIR/desk-lib/common.sh"
for _lib in lock status timeout model-call git-ops tool-results ticket-cache steps brief sleep-inhibit; do
	# shellcheck disable=SC1090
	source "$DESK_RUN_DIR/desk-lib/$_lib.sh"
done

pass="${1:-}"
if [ -z "$pass" ]; then
	echo "usage: desk-run <pass> [--rerun]   (a follow pass: desk-run <pass> [follow options])" >&2
	exit 2
fi
# `--rerun`: run the pass again for a scheduled date that already ran.
rerun="false"
[ "${2:-}" = "--rerun" ] && rerun="true"

# Without these a pass would fail halfway, so it refuses to start.
for _tool in jq realpath nvim git; do
	if ! command -v "$_tool" > /dev/null 2>&1; then
		desk_log "$pass" "required tool not found on PATH: $_tool"
		exit 2
	fi
done

desk_resolve_config
if [ -z "$DESK_CONFIG" ]; then
	desk_log "$pass" "\$DESK_CONFIG is not set, and there is no ${XDG_CONFIG_HOME:-$HOME/.config}/desk/config.json"
	exit 2
fi
if [ ! -f "$DESK_CONFIG" ]; then
	desk_log "$pass" "config file not found: $DESK_CONFIG"
	exit 2
fi
config="$(cat "$DESK_CONFIG")"
if ! jq -e . > /dev/null 2>&1 <<< "$config"; then
	desk_log "$pass" "\$DESK_CONFIG is not valid JSON: $DESK_CONFIG"
	exit 2
fi

desk_apply_calls_root "$config" "$(cd "$(dirname "$DESK_CONFIG")" && pwd)"

pass_config="$(jq -c --arg p "$pass" '.passes[$p] // empty' <<< "$config")"
if [ -z "$pass_config" ]; then
	desk_log "$pass" "unknown pass (no .passes.$pass in \$DESK_CONFIG)"
	exit 2
fi

# The follow pass: no once-a-day guard, no shared lock, no notes repo or
# status file.
if [[ "$(jq -r '.kind // empty' <<< "$pass_config")" == "follow" ]]; then
	source "$DESK_RUN_DIR/desk-lib/follow.sh"
	export DESK_CONFIG
	export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
	if [ "$rerun" = "true" ]; then
		desk_log "$pass" "--rerun is for the scheduled passes: a follow pass has no once-a-day guard, so desk-run $pass runs it now"
		exit 2
	fi
	desk_follow_main "$pass" "$pass_config" "${@:2}"
	exit $?
fi

# The ticket check's step id and search tool are the instance's to name.
ticket_status_step_id="$(jq -r '.ticket_status_step_id // empty' <<< "$config")"
ticket_search_tool="$(jq -r '.ticket_search_tool // empty' <<< "$config")"

# A weekdays_only pass skips every step but commit_push on a weekend slot;
# absent, true for a pass named morning.
case "$pass" in
	morning) weekday_default="true" ;;
	*) weekday_default="false" ;;
esac
weekday_only_pass="$(jq -r --arg d "$weekday_default" 'if .weekdays_only == null then $d else (.weekdays_only | tostring) end' <<< "$pass_config")"

# One lock for every pass, taken before anything reads or writes the status
# file: they share the notes repo, the ledger and the status file.
lockdir="$(desk_lock_acquire "$pass")"
if [ -z "$lockdir" ]; then
	desk_log "$pass" "gave up waiting for the lock"
	exit 1
fi

PASS_SCRATCH=""
cleanup() {
	desk_sleep_inhibit_release
	desk_lock_release
	[ -n "$PASS_SCRATCH" ] && rm -rf "$PASS_SCRATCH" 2> /dev/null
}
trap cleanup EXIT

desk_status_mark_stale_running "$pass"

# The guard is keyed on the slot's scheduled date, not the date the run
# happens on: an evening slot that only fires at the next morning's wake is
# still that evening's (lock.sh, desk_scheduled_date_for).
slots_json="$(jq -c '.trigger.start_calendar_interval // []' <<< "$pass_config")"
scheduled_date="$(desk_scheduled_date_for "$slots_json")"
scheduled_dow="$(desk_weekday_of_date "$scheduled_date")"
[ -n "$scheduled_dow" ] || scheduled_dow="$(date +%u)"
is_weekend="false"
[ "$scheduled_dow" -ge 6 ] && is_weekend="true"

# `trigger.same_day_only`: a run whose slot falls on an earlier day than
# today is a no-op, so a login or a wake catches up only today's slot.
if [ "$(jq -r '.trigger.same_day_only == true' <<< "$pass_config")" = "true" ]; then
	run_date="$(if desk_is_linux; then date -d "@$(desk_now)" +%F; else date -j -r "$(desk_now)" +%F; fi)"
	if [ "$scheduled_date" != "$run_date" ]; then
		desk_log "$pass" "slot of $scheduled_date, not today ($run_date), and same_day_only: no-op"
		exit 0
	fi
fi

# The once-a-day guard: a slot firing after this date's pass already ran is
# a no-op, whatever came of that run, except that it sends a brief still
# waiting for the central session.
if [ "$rerun" = "true" ]; then
	desk_log "$pass" "--rerun: running $scheduled_date again"
elif desk_guard_already_ran_today "$pass" "$scheduled_date"; then
	desk_log "$pass" "already ran today (scheduled $scheduled_date): no-op"
	desk_brief_retry "$pass" "$pass_config" "$config"
	exit 0
fi

PASS_SCRATCH="$(desk_scratch_dir "$pass-pass")"
desk_sleep_inhibit "$pass" "$PASS_SCRATCH"

# Every call this pass makes runs this copy of the deny hook, so a pull of
# this repo mid-pass never changes it under a call. No copy, no pass.
DESK_DENY_HOOK_SCRIPT="$PASS_SCRATCH/deny-unlisted-tool.sh"
if ! cp "$DESK_LIB_DIR/deny-unlisted-tool.sh" "$DESK_DENY_HOOK_SCRIPT" 2> /dev/null; then
	desk_log "$pass" "couldn't copy deny-unlisted-tool.sh into this pass's own scratch — refusing (a missing hook script must fail closed)"
	exit 2
fi
export DESK_DENY_HOOK_SCRIPT

desk_prune_old_runs
last_ok="$(desk_status_last_ok_run "$pass")"

# notes_repo must be an absolute path that is a repo's own toplevel, compared
# as physical paths: every step trusts it to be exactly the repo it commits
# and pushes.
repo="$(jq -r '.notes_repo' <<< "$config")"
repo="${repo/#\~/$HOME}"
case "$repo" in
	/*) : ;;
	*)
		desk_log "$pass" "notes_repo must be an absolute path: $repo"
		exit 2
		;;
esac
repo_resolved="$(cd -P "$repo" 2> /dev/null && pwd -P)"
if [ -z "$repo_resolved" ]; then
	desk_log "$pass" "notes_repo ($repo) doesn't exist — refusing"
	exit 2
fi
repo_toplevel="$(git -C "$repo_resolved" rev-parse --show-toplevel 2> /dev/null)"
if [ "$repo_toplevel" != "$repo_resolved" ]; then
	desk_log "$pass" "notes_repo ($repo) is not a git repo's own toplevel (got: ${repo_toplevel:-<not a git repo>}) — refusing"
	exit 2
fi
repo="$repo_resolved"
# Recorded as running only from here, so a run refused over its config never
# counts as the day's run.
desk_status_set_running "$pass" "$scheduled_date"
mapfile -t files < <(jq -r '.files[]' <<< "$config")
push_enabled="$(jq -r 'if .push_enabled == true then "true" else "false" end' <<< "$config")"
export DESK_CONFIG
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"

placeholders="$(jq -n --arg mode "$(desk_compute_mode "$last_ok")" --arg today "$(date +%F)" '{mode: $mode, today: $today}')"
sources_path="$(desk_prompt_path "$(jq -r '.sources_file // "sources.json"' <<< "$config")")"
# The cache as it stood before this pass's ticket check, which tickets.json
# is a diff against.
old_ticket_cache="$(cat "$DESK_TICKET_CACHE" 2> /dev/null)"
jq -e . > /dev/null 2>&1 <<< "$old_ticket_cache" || old_ticket_cache='{}'
pass_ctx="$(jq -n --arg repo "$repo" --arg sources_path "$sources_path" \
	--argjson old_ticket_cache "$old_ticket_cache" \
	'{repo: $repo, sources_path: $sources_path, old_ticket_cache: $old_ticket_cache}')"

# desk_run_fetch_step: runs the fetch step in $id and $step_json and sets
# $result. The ticket status check gets `{{jql}}` over every key the
# committed notes name, and its raw results become the ticket cache.
desk_run_fetch_step() {
	local step_placeholders="$placeholders" notes_text="" f
	if [ "$id" = "$ticket_status_step_id" ]; then
		for f in "${files[@]}"; do
			notes_text="$notes_text
$(git -C "$repo" show "HEAD:$f" 2> /dev/null)"
		done
		step_placeholders="$(jq -c --arg jql "$(desk_build_jql "$notes_text" "$(jq -c '.tokens // []' <<< "$config")")" \
			'. + {jql: $jql}' <<< "$placeholders")"
	fi
	result="$(desk_step_model_call "$pass" "$step_json" "$step_placeholders")"
	[ "$result" = "ok" ] && [ "$id" = "$ticket_status_step_id" ] || return 0
	# The search over every key is often past the output limit, so its
	# result is read from the saved file.
	_desk_follow_resolve_spills "$PASS_SCRATCH/$id-tool-results.jsonl" "$PASS_SCRATCH/$id-spill" \
		> "$PASS_SCRATCH/$id-tool-results.resolved" \
		&& mv -f "$PASS_SCRATCH/$id-tool-results.resolved" "$PASS_SCRATCH/$id-tool-results.jsonl"
	desk_build_ticket_cache "$PASS_SCRATCH/${id}-tool-uses.jsonl" "$PASS_SCRATCH/${id}-tool-results.jsonl" \
		"$ticket_search_tool" > /dev/null \
		|| desk_log "$pass" "$id: ticket cache parse failed, old cache kept"
}

overall_result="ok"
stopped_at=""
# A fetch or close that fails flags the pass partial and the rest still
# run; any other failure stops it.
failed_steps=()

steps_len="$(jq '.steps | length' <<< "$pass_config")"
for ((i = 0; i < steps_len; i++)); do
	step_json="$(jq -c ".steps[$i]" <<< "$pass_config")"
	id="$(jq -r '.id' <<< "$step_json")"
	kind="$(jq -r '.kind' <<< "$step_json")"

	if [ "$weekday_only_pass" = "true" ] && [ "$is_weekend" = "true" ] && [ "$kind" != "commit_push" ]; then
		desk_log "$pass" "step $id ($kind): skipped (weekend — model steps run weekdays only)"
		continue
	fi

	result="failed"
	case "$kind" in
		commit_push) result="$(desk_step_commit_push "$repo" "$push_enabled" "${files[@]}")" ;;
		fetch) desk_run_fetch_step ;;
		close) result="$(desk_step_close "$pass" "$config" "$scheduled_date")" ;;
		*) desk_log "$pass" "unknown step kind: $kind (step $id)" ;;
	esac
	desk_log "$pass" "step $id ($kind): $result"

	case "$result" in
		failed | timeout | error)
			if [ "$kind" != "fetch" ] && [ "$kind" != "close" ]; then
				overall_result="failed"
				stopped_at="$id"
				break
			fi
			failed_steps+=("$id")
			desk_log "$pass" "step $id ($kind): $result — the pass continues, flagged partial"
			if [ "$kind" = "fetch" ]; then
				desk_run_note "$id failed: $(desk_failed_source_reason "$id" "$result")."
			else
				desk_run_note "$id failed: it could not read the sessions (the log says why)."
			fi
			;;
	esac
done

failed_json="[]"
if [ "${#failed_steps[@]}" -gt 0 ]; then
	failed_json="$(printf '%s\n' "${failed_steps[@]}" | jq -R . | jq -cs .)"
	[ "$overall_result" = "ok" ] && overall_result="partial"
fi
desk_status_set_result "$pass" "$overall_result" "$stopped_at" "$failed_json" "$scheduled_date"

# A weekend slot of a weekdays-only pass prepares no brief of its own.
DESK_PASS_WEEKEND_SKIP="false"
[ "$weekday_only_pass" = "true" ] && [ "$is_weekend" = "true" ] && DESK_PASS_WEEKEND_SKIP="true"
export DESK_PASS_WEEKEND_SKIP
desk_brief_after_pass "$pass" "$pass_config" "$config" "$repo" "$scheduled_date" "$pass_ctx" \
	"$(jq -c --arg caps "$(desk_usual_size_string "$(desk_pass_caps_json "$pass" "$pass_config" "$config")")" \
		'. + {caps: $caps}' <<< "$placeholders")" "${files[@]}"

# The status line's view of the standing proposal: "pending" while any
# suggestion waits on the user, "partial" when this pass had a step fail,
# with counts by kind and by tier.
proposal_open_json="$(desk_nvim_cli proposal-open "$repo" 2> /dev/null)"
jq -e '.items | type == "array"' > /dev/null 2>&1 <<< "$proposal_open_json" || proposal_open_json='{"items":[]}'
desk_status_set_field proposal "$(jq -c --argjson partial "$([ "${#failed_steps[@]}" -gt 0 ] && echo true || echo false)" '
	(.items | length) as $n
	| {state: (if $partial then "partial" elif $n > 0 then "pending" else "none" end),
	   partial: $partial,
	   counts: {by_kind: ([.items[].kind] | group_by(.) | map({(.[0]): length}) | add // {}),
	            by_tier: ({act: 0, worth_knowing: 0, wildcard: 0}
	                      + ([.items[] | select(.tier) | .tier] | group_by(.) | map({(.[0]): length}) | add // {}))},
	   untaken: $n}' <<< "$proposal_open_json")"

# How old the ticket cache is now, whether or not this pass refreshed it.
ticket_cache_age_json="null"
if [ -f "$DESK_TICKET_CACHE" ]; then
	ticket_checked_at="$(jq -r '.checked_at // empty' "$DESK_TICKET_CACHE" 2> /dev/null)"
	[ -n "$ticket_checked_at" ] && ticket_cache_age_json=$(($(desk_now) - ticket_checked_at))
fi
desk_status_set_field ticket_cache_age "$ticket_cache_age_json"

total_cost_usd_json="0"
if [ -f "$PASS_SCRATCH/.costs.log" ]; then
	total_cost_usd_json="$(jq -s 'add // 0' "$PASS_SCRATCH/.costs.log" 2> /dev/null || echo 0)"
fi
desk_status_update '.passes[$pass].total_cost_usd = $cost' --arg pass "$pass" --argjson cost "$total_cost_usd_json"

desk_log "$pass" "done: $overall_result${stopped_at:+ (stopped at $stopped_at)}"

[ "$overall_result" != "failed" ]
