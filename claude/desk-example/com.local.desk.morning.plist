<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.desk.morning</string>
    <!-- launchd expands neither ~ nor $HOME, so the paths resolve through a
         shell. Replace the placeholders: the instance's config file, the
         config directory the user's sessions live in (CLAUDE_CONFIG_DIR: the
         capture and close steps read sessions from it), and the directory holding the `claude` binary (`dirname "$(command -v
         claude)"`). PATH must put a bash 4+ (Homebrew's) ahead of /bin, and
         reach jq, nvim, perl, rg and ~/.local/bin. The log is the only record
         of a pass's own progress; status.json holds its outcome. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>export DESK_CONFIG="$HOME/PATH/TO/INSTANCE/config.json"; export CLAUDE_CONFIG_DIR="$HOME/.claude"; export PATH="$HOME/.local/bin:CLAUDE_BIN_DIR:/opt/homebrew/bin:/usr/bin:/bin"; mkdir -p "$HOME/.local/state/desk/logs"; exec desk-run morning >> "$HOME/.local/state/desk/logs/morning.log" 2>&amp;1</string>
    </array>
    <!-- Mirror of the pass's `trigger.start_calendar_interval` in config.json:
         the runner never reads this file, so the two are kept equal by hand.
         The later slot only retries; once a scheduled date has finished ok,
         another firing for it is a no-op. A slot missed while asleep fires on
         wake; one missed while the Mac was off does not, which RunAtLoad
         below covers. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>8</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>
    <!-- Also run at load: at every login, so a morning after a restart or
         shutdown runs when the Mac is opened rather than at the next slot,
         and at `launchctl bootstrap`, so enabling the job runs it at once.
         The once-a-day guard makes a later slot that day a no-op. -->
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
