#!/usr/bin/env bash
# Updates Ghostty, a Homebrew cask, without losing the Claude Code sessions
# in its tabs. Replacing the app means quitting it, which ends every session
# running in it; this records them, quits Ghostty so it saves its windows,
# runs the brew step, relaunches it and resumes each session in the tab
# Ghostty restored for it. macOS only.
#
# Usage: ghostty-update [--dry-run] [--to ghostty|ghostty@tip]
#
#   (none)       upgrade whichever of the two casks is installed.
#   --to CASK    move to that cask: uninstall the installed one, then install
#                CASK. Naming the installed one is a plain upgrade.
#   --dry-run    say what it would do, and what it would refuse; change
#                nothing.
#
# Which sessions. Those the reader (session-status.sh) reports live, under
# each config dir in $GHOSTTY_UPDATE_CONFIG_DIRS (colon-separated; default
# ~/.claude and ~/.claude-work, the two the `claude` account switcher uses),
# whose tty a Ghostty terminal holds with the session in its foreground, as
# desk-close-tab.sh `find` names it for close-session.sh. A session on a tty
# no Ghostty terminal holds is left alone.
#
# Refused, with nothing done, when any of them could not come back as it
# was: held by two processes; not idle, running a shell command or a
# subagent, or with a wakeup or session cron pending in the process; started
# with flags a resume would drop or must not pass on; or without a
# transcript. The checks are restart-session.sh's (desk-lib/restartable.sh).
# Refused too when the process table shows a `claude` process under
# Ghostty that is not one of them (started under a config dir not listed,
# say), since the quit would end it unrecorded. The session running this
# command, if one is, is spared the idle check at first, since what it is
# running is this; the job waits for it to go idle. Unsent text in an input
# box is lost.
#
# Resuming into the restored tabs. Ghostty saves each terminal's id with its
# window state and gives the terminal the same id when it restores it
# (SurfaceView's Codable `uuid`, which is also the id its AppleScript
# reports, in the tip builds and in 1.4.0 alike, whose state format is the
# same version). So a session's tab is recorded by terminal id before the
# quit and found by it after; the cwd, shared by several tabs at once, is
# never what matches. Into that tab's restored shell, once it has settled,
# goes the resume restart-session.sh types (desk-lib/tab-resume.sh), and a
# new pid file naming the session confirms it. A session whose tab does not
# come back (its tab closed with it, since no shell in it outlives claude;
# Ghostty restored nothing; the restored tab never showed a prompt) is
# reopened in a new tab by reopen-sessions.sh --session, which carries no
# flags, and counts as resumed only once that reports it live; nothing then
# sits in its old tab, which was not restored. A resume typed by a helper
# call that timed out may have run, so that session is not reopened
# elsewhere: it is reported with the command to run by hand.
#
# Surviving the quit. Run from a Ghostty tab, this would die with Ghostty, so
# after the checks it hands the work to a launchd job (gui/<uid>/
# local.ghostty-update, bootstrapped from a plist beside its plan, carrying
# PATH, TMPDIR and the timing overrides below): a child of launchd in the
# user's GUI session, outside Ghostty's process tree, where Hammerspoon and
# Homebrew stay reachable. It logs to
# $DESK_STATE_DIR/logs/ghostty-update-<time>.log (default
# ~/.local/state/desk). Ghostty is driven through Hammerspoon, which already
# holds the permission to script it. The job:
#   1. fetches the new cask, so a swap never leaves the machine without
#      Ghostty for a download;
#   2. checks again, right before stopping anything: every session idle with
#      nothing scheduled (the one running this is waited for, up to
#      $GHOSTTY_UPDATE_CALLER_SECS, default 120), and no `claude` process
#      under Ghostty outside the plan. Any failing stops it there;
#   3. stops each session with SIGTERM, as close-session.sh does, recording
#      no end of its own, so each tab falls back to its prompt;
#   4. quits Ghostty as Cmd+Q does, so it saves its windows. Ghostty asks to
#      confirm when a tab is running something (an editor, a server), in a
#      sheet or an alert, which Hammerspoon sees through the accessibility
#      tree. While one is open, or none can be ruled out (Hammerspoon without
#      Accessibility), the job waits, up to $GHOSTTY_UPDATE_CONFIRM_WAIT_SECS
#      (default 1800), and says so in a notification; confirmed, it goes on.
#      Cancelled (Ghostty still running with no dialog,
#      $GHOSTTY_UPDATE_QUIT_SECS after the quit, default 20), it updates
#      nothing and resumes the sessions where they are. A quit call that
#      fails gets the same wait, since one that timed out may still have
#      been delivered. Still asking, or not known not to be, when the wait
#      runs out, it updates nothing and resumes nothing, since a later
#      confirm would end them again, and reports the commands to run once
#      it is answered;
#   5. runs `brew upgrade --cask <cask>`, or for --to, `brew uninstall
#      --cask <old>` then `brew install --cask <new>`, putting the old one
#      back if the install fails;
#   6. relaunches Ghostty (only if it was running), resumes the sessions,
#      and reports in a notification: what was updated, from which version
#      to which, or in a few words why not and what to do, how many
#      sessions came back and the names of any that did not, the log, and a file beside it with each failed one's exact resume
#      command (`<log>` with `.resume` for `.log`).
# The job is left loaded once it ends and booted out by the next run.
#
# Exit codes: 0 the job was started (or --dry-run, or nothing to update); 1
# refused or failed before anything changed; 2 usage.
#
# Overrides (tests): $DESK_READER, $DESK_CLOSE_TAB_BIN, $DESK_OPEN_TAB_BIN
# (for reopen-sessions.sh), $DESK_STATE_DIR, $RESTART_SESSION_PS,
# $RESTART_SESSION_ARGV, $GHOSTTY_UPDATE_BREW (default brew),
# $GHOSTTY_UPDATE_APP_BIN (a command taking running, quit, dialog, launch
# or version in place of the built-in Ghostty control),
# $GHOSTTY_UPDATE_NOTIFY_BIN (given a title and a text),
# $GHOSTTY_UPDATE_DETACH_BIN (given the job's spec, a JSON file holding its
# ProgramArguments and EnvironmentVariables, in place of launchd),
# $GHOSTTY_UPDATE_CONFIG_DIRS, $DESK_HS_TIMEOUT_SECS, and the waits
# $GHOSTTY_UPDATE_DELAY_SECS (before the job acts, default 5), _CALLER_SECS
# (120), _GRACE_SECS (10), _QUIT_SECS (20), _CONFIRM_WAIT_SECS (1800),
# _LAUNCH_SECS (180), _RESTORE_SECS (30, once Ghostty runs), _PROMPT_SECS
# (15), _CONFIRM_SECS (30) and _TAB_TIMEOUT_SECS (10).
set -u

script_dir() {
	local src="${BASH_SOURCE[0]}" dir
	while [ -h "$src" ]; do
		dir="$(cd -P "$(dirname "$src")" && pwd)"
		src="$(readlink "$src")"
		[[ "$src" != /* ]] && src="$dir/$src"
	done
	cd -P "$(dirname "$src")" && pwd
}
HERE="$(script_dir)"
SELF="$HERE/$(basename "${BASH_SOURCE[0]}")"

desk_pid_alive() { kill -0 "$1" 2> /dev/null; }
DESK_KILL_GRACE_SECS=2
# shellcheck source=desk-lib/timeout.sh
source "$HERE/desk-lib/timeout.sh"
# shellcheck source=desk-lib/restartable.sh
source "$HERE/desk-lib/restartable.sh"
# shellcheck source=desk-lib/liveness.sh
source "$HERE/desk-lib/liveness.sh"
# shellcheck source=desk-lib/tab-resume.sh
source "$HERE/desk-lib/tab-resume.sh"
# shellcheck source=../hammerspoon/hs-call.sh
source "$HERE/../hammerspoon/hs-call.sh"

READER="${DESK_READER:-session-status.sh}"
TAB_HELPER="${DESK_CLOSE_TAB_BIN:-desk-close-tab.sh}"
TAB_TIMEOUT="${GHOSTTY_UPDATE_TAB_TIMEOUT_SECS:-10}"
BREW="${GHOSTTY_UPDATE_BREW:-brew}"
STATE_DIR="${DESK_STATE_DIR:-$HOME/.local/state/desk}"
CONFIG_DIRS="${GHOSTTY_UPDATE_CONFIG_DIRS:-$HOME/.claude:$HOME/.claude-work}"
DELAY_SECS="${GHOSTTY_UPDATE_DELAY_SECS:-5}"
CALLER_SECS="${GHOSTTY_UPDATE_CALLER_SECS:-120}"
GRACE="${GHOSTTY_UPDATE_GRACE_SECS:-10}"
QUIT_SECS="${GHOSTTY_UPDATE_QUIT_SECS:-20}"
CONFIRM_WAIT_SECS="${GHOSTTY_UPDATE_CONFIRM_WAIT_SECS:-1800}"
LAUNCH_SECS="${GHOSTTY_UPDATE_LAUNCH_SECS:-180}"
RESTORE_SECS="${GHOSTTY_UPDATE_RESTORE_SECS:-30}"
PROMPT_SECS="${GHOSTTY_UPDATE_PROMPT_SECS:-15}"
CONFIRM_SECS="${GHOSTTY_UPDATE_CONFIRM_SECS:-30}"
LABEL=local.ghostty-update
APP_PATH=/Applications/Ghostty.app
BUNDLE_ID=com.mitchellh.ghostty
CASKS="ghostty ghostty@tip"
# Long enough for a slow download; a brew step that hangs past it is killed.
BREW_TIMEOUT=1200
# How long Ghostty must show no dialog, still running, to count as a quit
# cancelled: a review of several windows' confirmations has gaps between
# them.
NO_DIALOG_SECS=5

usage() {
	sed -n '/^# Usage:/,/^#   --dry-run/{s/^# \{0,1\}//;p;}' "$0" >&2
	exit 2
}

dry_run=false
to=""
job=""
while [ $# -gt 0 ]; do
	case "$1" in
		--dry-run) dry_run=true ;;
		--to)
			[ $# -ge 2 ] || usage
			to="$2"
			shift
			;;
		--job)
			[ $# -ge 2 ] || usage
			job="$2"
			shift
			;;
		*) usage ;;
	esac
	shift
done
if [ -n "$to" ]; then
	case " $CASKS " in *" $to "*) ;; *) usage ;; esac
fi

# A Lua call's own answer: the last line hs printed. Fails, printing what hs
# printed, when the call did not go through.
hs_answer() {
	local out
	out="$(run_hs "$1" 2>&1)" || { printf '%s\n' "$out" | tr '\n' ' '; return 1; }
	printf '%s\n' "$out" | tail -n 1
}

# Ghostty itself: running (exit 0 when it is), quit (as Cmd+Q, so it saves
# its windows and asks about anything running; fails, saying why, when the
# call to Hammerspoon does), dialog (prints dialog while a sheet or an alert
# is open in it, none when none is; fails, unknown, when it cannot tell),
# launch, and version
# (what the installed app says it is).
app() {
	if [ -n "${GHOSTTY_UPDATE_APP_BIN:-}" ]; then
		"$GHOSTTY_UPDATE_APP_BIN" "$@"
		return
	fi
	local answer
	case "$1" in
		# By the executable's path: pgrep -f does not see the app's argv.
		running) ps -axo comm= | grep -qxF "$APP_PATH/Contents/MacOS/ghostty" ;;
		quit)
			answer="$(hs_answer "local a = hs.application.get(\"$BUNDLE_ID\"); if a then a:kill() end; return true")" \
				&& [ "$answer" = true ] || { echo "${answer:-no answer}"; return 1; }
			;;
		dialog)
			# Without Accessibility, or with Ghostty's windows unreadable, no
			# dialog would show either: that is unknown, never none.
			answer="$(hs_answer "if not hs.accessibilityState() then return \"unknown\" end
				local a = hs.application.get(\"$BUNDLE_ID\")
				if not a then return \"none\" end
				local ax = hs.axuielement.applicationElement(a)
				if not ax then return \"unknown\" end
				local windows = ax:attributeValue(\"AXWindows\")
				if windows == nil then
					if #a:allWindows() > 0 then return \"unknown\" end
					return \"none\"
				end
				for _, w in ipairs(windows) do
					local sr = w:attributeValue(\"AXSubrole\")
					if sr == \"AXDialog\" or sr == \"AXSystemDialog\" then return \"dialog\" end
					for _, c in ipairs(w:attributeValue(\"AXChildren\") or {}) do
						if c:attributeValue(\"AXRole\") == \"AXSheet\" then return \"dialog\" end
					end
				end
				return \"none\"")" || return 1
			case "$answer" in dialog | none) echo "$answer" ;; *) echo unknown; return 1 ;; esac
			;;
		launch) open -a "$APP_PATH" ;;
		version)
			local plist="$APP_PATH/Contents/Info.plist" short build
			short="$(defaults read "$plist" CFBundleShortVersionString 2> /dev/null)"
			build="$(defaults read "$plist" CFBundleVersion 2> /dev/null)"
			if [ -z "$short" ]; then
				echo "none installed"
			elif [ -n "$build" ] && [ "$build" != "$short" ]; then
				echo "$short (build $build)"
			else
				echo "$short"
			fi
			;;
	esac
}

notify() { # title text
	if [ -n "${GHOSTTY_UPDATE_NOTIFY_BIN:-}" ]; then
		"$GHOSTTY_UPDATE_NOTIFY_BIN" "$1" "$2"
		return
	fi
	hs_answer "hs.notify.new({title = $(lua_string "$1"), informativeText = $(lua_string "$2"), withdrawAfter = 0}):send(); return true" > /dev/null \
		|| osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' -e 'end run' "$1" "$2" > /dev/null 2>&1
}

by_hand() { # cwd config-dir carry id
	tab_resume_command "$1" "$2" "${3:+$3 }--resume $4"
}

# The `claude` processes under Ghostty, from $procs: `<pid> <args>` for each
# whose argv starts with a claude and which descends from Ghostty's own
# process, so the quit would end it.
ghostty_claudes() {
	awk -v app="$APP_PATH/Contents/MacOS/ghostty" '
		{
			pid = $1; parent[pid] = $2
			args = $0; sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+/, "", args); argv[pid] = args
			split(args, w, " "); n = split(w[1], p, "/")
			if (p[n] == "claude") claude[pid] = 1
			if (index(args, app) == 1) ghostty[pid] = 1
		}
		END {
			for (c in claude) {
				q = parent[c]
				for (i = 0; i < 64 && q != "" && q != 0; i++) {
					if (q in ghostty) { print c " " argv[c]; break }
					q = parent[q]
				}
			}
		}' <<< "$procs"
}

# The `claude` processes under Ghostty that are not among <pid>..., each
# named with the session its pid file names under any config dir.
unplanned_claudes() { # planned pid...
	local planned=" $* " pid args d sid
	while read -r pid args; do
		[ -n "$pid" ] || continue
		case "$planned" in *" $pid "*) continue ;; esac
		sid=""
		IFS=: read -r -a dirs <<< "$CONFIG_DIRS"
		for d in "${dirs[@]}" "$HOME/.claude" "$HOME/.claude-work"; do
			sid="$(jq -r '.sessionId // empty' "${d%/}/sessions/$pid.json" 2> /dev/null)"
			[ -n "$sid" ] && break
		done
		printf 'pid %s (%s)%s\n' "$pid" "$args" "${sid:+, session $sid}"
	done < <(ghostty_claudes)
}

# ==========================================================================
# The job: everything from the fetch to the report, detached.
# ==========================================================================
run_job() {
	local plan=$1
	local log resume_file action from_cask to_cask from_version to_version was_running caller
	log="$(jq -r '.log' "$plan")"
	resume_file="${log%.log}.resume"
	exec >> "$log" 2>&1
	action="$(jq -r '.action' "$plan")"
	from_cask="$(jq -r '.from_cask' "$plan")"
	to_cask="$(jq -r '.to_cask' "$plan")"
	from_version="$(jq -r '.from_version' "$plan")"
	was_running="$(jq -r '.ghostty_running' "$plan")"
	caller="$(jq -r '.caller // ""' "$plan")"
	logl() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*"; }
	local what="$from_cask $from_version"
	[ "$action" = switch ] && what="$what, moving to $to_cask"

	mapfile -t sessions < <(jq -c '.sessions[]' "$plan")
	logl "job started (pid $$): $what; ${#sessions[@]} session(s) to resume"
	notify "Updating Ghostty" "$what. Ghostty quits in a moment and comes back with its sessions. If it asks to confirm quitting, confirm; if macOS asks whether to open it afterwards, open it. Log: $log"
	sleep "$DELAY_SECS"

	local abort=""
	logl "fetching $to_cask"
	"$BREW" fetch --cask "$to_cask" < /dev/null || abort="brew could not fetch $to_cask"

	# --- the second look, right before anything is stopped ---
	local s id name dir pid transcript cwd carry terminal pidfile kept=() pids=() until_s line
	for s in "${sessions[@]+"${sessions[@]}"}"; do
		[ -z "$abort" ] || break
		IFS=$'\t' read -r id name dir pid transcript < <(jq -r '[.id, .name, .config_dir, .pid, .transcript] | @tsv' <<< "$s")
		[ "$id" = "$caller" ] || continue
		pidfile="$dir/sessions/$pid.json"
		CONFIG_DIR="$dir"
		until_s=$((SECONDS + CALLER_SECS))
		while :; do
			restartable_procs || { abort="could not list processes"; break; }
			[ "$(jq -r '.sessionId // empty' "$pidfile" 2> /dev/null)" = "$id" ] || break
			restartable_idle "$pid" "$pidfile" "$(dirname "$transcript")/$id/subagents" && break
			if [ "$SECONDS" -ge "$until_s" ]; then
				abort="$name ($id), the session that ran this, did not go idle within ${CALLER_SECS}s: $restartable_why"
				break
			fi
			sleep 1
		done
	done
	[ -n "$abort" ] || restartable_procs || abort="could not list processes"
	for s in "${sessions[@]+"${sessions[@]}"}"; do
		[ -z "$abort" ] || break
		IFS=$'\t' read -r id name dir pid transcript < <(jq -r '[.id, .name, .config_dir, .pid, .transcript] | @tsv' <<< "$s")
		pidfile="$dir/sessions/$pid.json"
		if [ "$(jq -r '.sessionId // empty' "$pidfile" 2> /dev/null)" != "$id" ]; then
			logl "$name ($id) has ended since the first look; not resumed"
			continue
		fi
		CONFIG_DIR="$dir"
		if ! restartable_idle "$pid" "$pidfile" "$(dirname "$transcript")/$id/subagents"; then
			abort="$name ($id) is no longer idle: $restartable_why"
		elif ! restartable_schedules "$pidfile" "$transcript"; then
			abort="$name ($id): $restartable_why"
		fi
		kept+=("$s")
		pids+=("$pid")
	done
	if [ -z "$abort" ]; then
		line="$(unplanned_claudes ${pids[@]+"${pids[@]}"} | paste -sd';' - | sed 's/;/; /g')"
		[ -z "$line" ] || abort="Claude Code is running under Ghostty outside the plan, which the quit would end: $line"
	fi
	if [ -n "$abort" ]; then
		logl "nothing done: $abort"
		notify "Ghostty not updated" "Nothing was done: $abort. Log: $log"
		return 1
	fi
	sessions=(${kept[@]+"${kept[@]}"})

	# --- stop the sessions, then quit Ghostty ---
	for s in "${sessions[@]+"${sessions[@]}"}"; do
		pid="$(jq -r '.pid' <<< "$s")"
		kill -TERM "$pid" 2> /dev/null
	done
	local left
	until_s=$((SECONDS + GRACE))
	while :; do
		left=0
		for s in "${sessions[@]+"${sessions[@]}"}"; do
			IFS=$'\t' read -r pid dir < <(jq -r '[.pid, .config_dir] | @tsv' <<< "$s")
			{ desk_pid_alive "$pid" || [ -e "$dir/sessions/$pid.json" ]; } && left=$((left + 1))
		done
		[ "$left" -eq 0 ] || [ "$SECONDS" -ge "$until_s" ] && break
		sleep 0.2
	done
	if [ "$left" -gt 0 ]; then
		logl "stopped the sessions; $left still going after ${GRACE}s, left to Ghostty's quit"
	else
		logl "stopped the sessions"
	fi

	# quit: quit (Ghostty is gone), failed (the quit call failed and Ghostty
	# stayed), cancelled (still running, no dialog), asking (a dialog open,
	# or none that can be ruled out, when the wait ran out). A quit call that
	# fails may still have been delivered (a timeout), so the wait runs
	# whatever it returned.
	local quit=quit updated=false brew_note="" short_note="" out d quit_err="" no_dialog_since told="" quit_until wait_until
	if [ "$was_running" = true ]; then
		logl "quitting Ghostty"
		if ! out="$(app quit 2>&1)"; then
			quit_err="${out:-no answer}"
			logl "the quit call to Hammerspoon failed ($quit_err); watching whether Ghostty quits anyway"
		fi
		quit_until=$((SECONDS + QUIT_SECS))
		wait_until=$((SECONDS + CONFIRM_WAIT_SECS))
		no_dialog_since=$SECONDS
		while app running; do
			# One it cannot tell about counts as open: resuming into a
			# Ghostty that is about to quit is the outcome to avoid.
			d="$(app dialog 2> /dev/null)" || d=unknown
			if [ "$d" != none ]; then
				no_dialog_since=""
				if [ -z "$told" ]; then
					told=1
					if [ "$d" = dialog ]; then
						logl "Ghostty is asking to confirm the quit; waiting up to ${CONFIRM_WAIT_SECS}s"
						notify "Ghostty update waiting" "Ghostty is asking whether to quit. Confirm to go on with the update; cancel to keep $from_cask, with the sessions resumed in their tabs."
					else
						logl "cannot tell whether Ghostty is asking to confirm the quit (Hammerspoon without Accessibility?); waiting up to ${CONFIRM_WAIT_SECS}s"
						notify "Ghostty update waiting" "Ghostty has not quit, and whether it is asking to cannot be seen (Hammerspoon without Accessibility?). Confirm or cancel if it is asking; the update waits for it."
					fi
				fi
			else
				[ -n "$no_dialog_since" ] || no_dialog_since=$SECONDS
				if { [ "$SECONDS" -ge "$quit_until" ] && [ $((SECONDS - no_dialog_since)) -ge "$NO_DIALOG_SECS" ]; } \
					|| [ "$SECONDS" -ge "$wait_until" ]; then
					if [ -n "$quit_err" ]; then
						quit=failed
						brew_note="the quit call to Hammerspoon failed ($quit_err) and Ghostty stayed, so nothing was updated"
						short_note="The quit call to Hammerspoon failed"
					else
						quit=cancelled
						brew_note="Ghostty did not quit (the quit was cancelled), so nothing was updated"
						short_note="The quit was cancelled"
					fi
					break
				fi
			fi
			if [ "$SECONDS" -ge "$wait_until" ] && [ "$d" != none ]; then
				quit=asking
				if [ "$d" = dialog ]; then
					brew_note="Ghostty was still asking to confirm the quit after ${CONFIRM_WAIT_SECS}s"
					short_note="Ghostty is still asking whether to quit; answer it, then resume the sessions by hand"
				else
					brew_note="Ghostty had not quit after ${CONFIRM_WAIT_SECS}s, and whether it is asking to could not be seen"
					short_note="Ghostty has not quit and may be asking whether to; answer it, then resume the sessions by hand"
				fi
				brew_note="$brew_note, so nothing was updated and no session resumed, since confirming would end them again; answer it, then resume them by hand"
				break
			fi
			sleep 0.5
		done
		[ -z "$brew_note" ] || logl "$brew_note"
	fi

	# --- the brew step ---
	if [ "$quit" = quit ]; then
		local rc
		out="$(mktemp "${TMPDIR:-/tmp}/ghostty-update.XXXXXX")"
		brew_step() { # args...
			logl "brew $*"
			run_with_timeout "$BREW_TIMEOUT" "$out" "$BREW" "$@" < /dev/null
			rc=$?
			cat "$out" "$out.stderr" 2> /dev/null
			rm -f "$out.stderr"
			return "$rc"
		}
		if [ "$action" = upgrade ]; then
			if brew_step upgrade --cask "$to_cask"; then
				updated=true
			else
				brew_note="brew upgrade --cask $to_cask failed (exit $rc)"
				short_note="brew upgrade failed"
			fi
		elif brew_step uninstall --cask "$from_cask"; then
			if brew_step install --cask "$to_cask"; then
				updated=true
			else
				brew_note="brew install --cask $to_cask failed (exit $rc)"
				if brew_step install --cask "$from_cask"; then
					brew_note="$brew_note; put $from_cask back"
					short_note="Installing $to_cask failed, so $from_cask was put back"
				else
					brew_note="$brew_note, and putting $from_cask back failed too: install one by hand"
					short_note="Installing $to_cask failed and putting $from_cask back did too; install Ghostty by hand: brew install --cask $to_cask"
				fi
			fi
		else
			brew_note="brew uninstall --cask $from_cask failed (exit $rc), so $to_cask was not installed"
			short_note="brew uninstall failed"
		fi
		rm -f "$out"
		[ -z "$brew_note" ] || logl "$brew_note"
	fi
	to_version="$(app version)"
	logl "Ghostty is now $to_version"

	local resumed=() failed=() reopen=() typed=() unreachable=""
	fail() { # name why cmd
		failed+=("$(jq -cn --arg n "$1" --arg why "$2" --arg cmd "$3" '{name: $n, why: $why, cmd: $cmd}')")
	}
	if [ "$quit" = asking ]; then
		unreachable="not resumed while Ghostty asks to confirm quitting"
	elif [ "$quit" = quit ] && [ "$was_running" = true ]; then
		logl "launching Ghostty"
		app launch || logl "launching Ghostty failed"
		# It may take a while to come up (macOS can ask whether to open an
		# app just downloaded).
		until_s=$((SECONDS + LAUNCH_SECS))
		until app running || [ "$SECONDS" -ge "$until_s" ]; do sleep 0.5; done
		if ! app running; then
			unreachable="Ghostty is not running after ${LAUNCH_SECS}s"
			short_note="Ghostty did not come back; open it, then resume the sessions by hand"
		fi
	fi

	# --- resume the sessions ---
	local t restored="" any_terminal=""
	if [ -z "$unreachable" ]; then
		for s in "${sessions[@]+"${sessions[@]}"}"; do
			[ -n "$(jq -r '.terminal' <<< "$s")" ] && any_terminal=1
		done
		# Restored terminals take a moment to appear: wait for the first that
		# was recorded, so a tab not found after that is one not restored.
		until_s=$((SECONDS + RESTORE_SECS))
		while [ -n "$any_terminal" ] && [ "$SECONDS" -lt "$until_s" ]; do
			for s in "${sessions[@]}"; do
				t="$(jq -r '.terminal' <<< "$s")"
				[ -n "$t" ] || continue
				tab_call pid "$t"
				[ "$tab_rc" -eq 0 ] && { restored=1; break 2; }
			done
			sleep 0.5
		done
		[ -z "$any_terminal" ] || [ -n "$restored" ] \
			|| logl "Ghostty restored none of the sessions' tabs within ${RESTORE_SECS}s"
	fi

	for s in "${sessions[@]+"${sessions[@]}"}"; do
		IFS=$'\t' read -r id name dir pid cwd terminal carry < <(jq -r '[.id, .name, .config_dir, .pid, .cwd, .terminal, .carry] | @tsv' <<< "$s")
		if [ -n "$unreachable" ]; then
			fail "$name" "$unreachable" "$(by_hand "$cwd" "$dir" "$carry" "$id")"
			continue
		fi
		if [ -z "$terminal" ] || [ -z "$restored" ]; then
			reopen+=("$s")
			continue
		fi
		# Once Ghostty has restored a recorded tab, one it says it has no
		# terminal for is one it did not restore, not one still coming.
		tab_call pid "$terminal"
		case "$tab_why" in
			*"no Ghostty terminal has that id"*)
				logl "$name ($id): Ghostty did not restore its tab; reopening it in a new tab"
				reopen+=("$s")
				continue ;;
		esac
		if ! tab_await_prompt "$terminal" "$PROMPT_SECS"; then
			logl "$name ($id): its tab showed no settled prompt (${tab_unreached:-${tab_last_seen:-nothing in the foreground}}); reopening it in a new tab"
			reopen+=("$s")
			continue
		fi
		tab_call type "$terminal" "$tab_shell_pid" "$(tab_resume_text "$cwd" "$dir" "${carry:+$carry }--resume $id")"
		if [ "$tab_rc" -eq 0 ] || [ "$tab_rc" -eq 124 ]; then
			typed+=("$(jq -c --arg maybe "$([ "$tab_rc" -eq 124 ] && echo true)" '. + {maybe: ($maybe == "true")}' <<< "$s")")
		else
			logl "$name ($id): the resume was not typed into its tab (${tab_why:-exit $tab_rc}); reopening it in a new tab"
			reopen+=("$s")
		fi
	done

	local now_pid
	until_s=$((SECONDS + CONFIRM_SECS))
	for s in "${typed[@]+"${typed[@]}"}"; do
		IFS=$'\t' read -r id name dir pid cwd carry < <(jq -r '[.id, .name, .config_dir, .pid, .cwd, .carry] | @tsv' <<< "$s")
		now_pid=""
		while :; do
			now_pid="$(tab_resumed_pid "$dir" "$id" "$pid")" && break
			now_pid=""
			[ "$SECONDS" -ge "$until_s" ] && break
			sleep 0.25
		done
		if [ -n "$now_pid" ]; then
			resumed+=("$name: in its tab")
		elif [ "$(jq -r '.maybe' <<< "$s")" = true ]; then
			fail "$name" "the helper timed out typing its resume and it is not live; look at its tab first" "$(by_hand "$cwd" "$dir" "$carry" "$id")"
		else
			fail "$name" "typed into its tab but not live after ${CONFIRM_SECS}s; look at the tab first" "$(by_hand "$cwd" "$dir" "$carry" "$id")"
		fi
	done

	# The rest in new tabs, through reopen-sessions.sh, one call per config
	# dir, since it reads one. Only an open it saw go live counts.
	if [ "${#reopen[@]}" -gt 0 ]; then
		local dirs dd args out_json r st detail live
		dirs="$(printf '%s\n' "${reopen[@]}" | jq -r '.config_dir' | sort -u)"
		while IFS= read -r dd; do
			args=()
			for s in "${reopen[@]}"; do
				[ "$(jq -r '.config_dir' <<< "$s")" = "$dd" ] && args+=(--session "$(jq -r '.id' <<< "$s")")
			done
			out_json="$(CLAUDE_CONFIG_DIR="$dd" "$HERE/reopen-sessions.sh" --json "${args[@]}" < /dev/null 2> /dev/null)"
			for s in "${reopen[@]}"; do
				[ "$(jq -r '.config_dir' <<< "$s")" = "$dd" ] || continue
				IFS=$'\t' read -r id name cwd carry < <(jq -r '[.id, .name, .cwd, .carry] | @tsv' <<< "$s")
				r="$(jq -c --arg id "$id" '.sessions[]? | select(.id == $id)' <<< "$out_json" 2> /dev/null | head -n 1)"
				[ -n "$r" ] || r='{}'
				IFS=$'\t' read -r st live detail < <(jq -r '[.status // "", (.confirmed_live == true | tostring), .detail // ""] | @tsv' <<< "$r" 2> /dev/null)
				if [ "$st" = opened ] && [ "$live" = true ]; then
					resumed+=("$name: in a new tab${carry:+ (without $carry)}")
				else
					fail "$name" "${st:-no answer}: ${detail:-reopen-sessions.sh gave no answer for it}" "$(by_hand "$cwd" "$dd" "$carry" "$id")"
				fi
			done
		done <<< "$dirs"
	fi

	# --- the report: short in the notification, whole in the log ---
	local title text names
	if [ "$updated" = true ]; then
		title="Ghostty updated"
		text="$from_cask $from_version -> $to_cask $to_version.${short_note:+ $short_note.}"
	else
		title="Ghostty not updated"
		text="${short_note:-Nothing was updated}."
		if [ "$to_version" = "none installed" ]; then
			text="$text No Ghostty is installed."
		else
			text="$text Still $from_cask $to_version."
		fi
	fi
	text="$text ${#resumed[@]} of $((${#resumed[@]} + ${#failed[@]})) sessions resumed."
	logl "$title: $text${brew_note:+ $brew_note.}"
	for line in "${resumed[@]+"${resumed[@]}"}"; do logl "  resumed  $line"; done
	if [ "${#failed[@]}" -gt 0 ]; then
		: > "$resume_file"
		for line in "${failed[@]}"; do
			logl "  FAILED   $(jq -r '"\(.name): \(.why); \(.cmd)"' <<< "$line")"
			jq -r '"# \(.name): \(.why)\n\(.cmd)"' <<< "$line" >> "$resume_file"
		done
		names="$(printf '%s\n' "${failed[@]}" | jq -r '.name' | paste -sd, - | sed 's/,/, /g')"
		text="$text Not resumed: $names; commands in $resume_file."
	fi
	notify "$title" "$text Log: $log"
	logl "job done"
	[ "$updated" = true ] && [ "${#failed[@]}" -eq 0 ]
}

if [ -n "$job" ]; then
	run_job "$job"
	exit $?
fi

# ==========================================================================
# The first look, in the foreground: what would change, and what refuses.
# ==========================================================================
die() {
	printf 'ghostty-update: %s\n' "$1" >&2
	exit 1
}

installed=""
for c in $CASKS; do
	if "$BREW" list --cask --versions "$c" > /dev/null 2>&1 < /dev/null; then
		[ -z "$installed" ] || die "both $installed and $c are installed; uninstall one first"
		installed="$c"
	fi
done
[ -n "$installed" ] || die "neither of $CASKS is installed through Homebrew"
target="${to:-$installed}"
from_version="$(app version)"
to_version="$("$BREW" info --cask --json=v2 "$target" < /dev/null 2> /dev/null | jq -r '.casks[0].version // empty' 2> /dev/null)"
if [ "$target" = "$installed" ]; then
	action=upgrade
	if [ -z "$("$BREW" outdated --cask --greedy --quiet "$target" < /dev/null 2> /dev/null)" ]; then
		echo "ghostty-update: $installed is up to date ($from_version); nothing to do"
		exit 0
	fi
	headline="upgrade $installed from $from_version to ${to_version:-the latest}"
else
	action=switch
	headline="move from $installed $from_version to $target ${to_version:-latest} (brew uninstall --cask $installed, then brew install --cask $target)"
fi

ghostty_running=false
app running && ghostty_running=true

# Every live session the readers report, one JSON object per line.
read_live() {
	local d
	IFS=: read -r -a dirs <<< "$CONFIG_DIRS"
	for d in "${dirs[@]}"; do
		d="${d%/}"
		[ -d "$d" ] || continue
		CLAUDE_CONFIG_DIR="$d" "$READER" < /dev/null 2> /dev/null \
			| jq -c --arg d "$d" 'select(.live == true) | . + {config_dir: $d}' 2> /dev/null
	done
}

plan_sessions=()
plan_pids=()
declare -A not_in_tab=()
refusals=()
alone=()
caller="${CLAUDE_CODE_SESSION_ID:-}"
if [ "$ghostty_running" = true ]; then
	restartable_procs || die "could not list processes"
	seen=" "
	while IFS= read -r e; do
		[ -n "$e" ] || continue
		IFS=$'\t' read -r id name dir pid tty cwd transcript dup < <(jq -r '
			[.id, (.name // "" | if . == "" then "(unnamed)" else . end), .config_dir, (.pid // "" | tostring),
			 (.tty // ""), (.cwd // ""), (.transcript_path // ""), (.duplicate_pids == true | tostring)] | @tsv' <<< "$e")
		case "$seen" in *" $id "*) continue ;; esac
		seen="$seen$id "
		label="$name ($id)"
		if [ -z "$tty" ] || [ "$tty" = "??" ]; then
			alone+=("$label: no terminal")
			continue
		fi
		tab_call find "$tty" "$pid"
		terminal=""
		how="in its tab"
		if [ "$tab_rc" -eq 0 ] && [ -n "$tab_out" ]; then
			terminal="$tab_out"
		elif [ "$tab_rc" -eq 1 ]; then
			case "$tab_why" in
				*"no Ghostty terminal is on"* | *"Ghostty is not running"*)
					alone+=("$label: not in a Ghostty tab")
					not_in_tab[$pid]="$label"
					continue ;;
			esac
			how="in a new tab, since its tab could not be told apart ($tab_why)"
		else
			die "Hammerspoon did not answer about $label's tab (${tab_why:-exit $tab_rc}); nothing done"
		fi
		# Counted as planned from here, so a refusal below is not reported a
		# second time as a process outside the plan.
		plan_pids+=("$pid")
		if [ "$dup" = true ]; then
			refusals+=("$label: more than one process holds it")
			continue
		fi
		if [ -z "$transcript" ]; then
			refusals+=("$label: no transcript, so no way to tell whether subagents are running")
			continue
		fi
		CONFIG_DIR="$dir"
		pidfile="$dir/sessions/$pid.json"
		if [ "$id" != "$caller" ] && ! restartable_idle "$pid" "$pidfile" "$(dirname "$transcript")/$id/subagents"; then
			refusals+=("$label: $restartable_why")
			continue
		fi
		if ! restartable_schedules "$pidfile" "$transcript"; then
			refusals+=("$label: $restartable_why")
			continue
		fi
		if ! restartable_flags "$pid" "${cwd:-/}"; then
			refusals+=("$label: $restartable_why")
			continue
		fi
		if [ -n "$terminal" ] && ! restartable_prompt "$pid"; then
			terminal=""
			how="in a new tab, since its tab closes with the session"
		fi
		[ "$id" = "$caller" ] && how="$how (the session running this, once it is idle)"
		plan_sessions+=("$(jq -cn --arg id "$id" --arg name "$name" --arg dir "$dir" --arg pid "$pid" --arg tty "$tty" \
			--arg cwd "$cwd" --arg tp "$transcript" --arg terminal "$terminal" --arg carry "$restartable_carry" --arg how "$how" '
			{id: $id, name: $name, config_dir: $dir, pid: $pid, tty: $tty, cwd: $cwd, transcript: $tp,
			 terminal: $terminal, carry: $carry, how: $how}')")
	done < <(read_live)
	# One a reader reports, but on a tty no Ghostty tab holds, runs inside
	# another program's terminal in a tab (nvim's :terminal, say), where its
	# tab cannot be named; one no reader reports runs under a config dir not
	# listed.
	while IFS= read -r line; do
		[ -n "$line" ] || continue
		pid="${line#pid }"
		pid="${pid%% *}"
		if [ -n "${not_in_tab[$pid]:-}" ]; then
			refusals+=("${not_in_tab[$pid]}: runs under Ghostty inside another program's terminal (an nvim :terminal, say), not in a tab's foreground, so its tab cannot be found and the quit would end it")
			for i in "${!alone[@]}"; do
				[ "${alone[$i]}" = "${not_in_tab[$pid]}: not in a Ghostty tab" ] && unset 'alone[i]'
			done
		else
			refusals+=("Claude Code under Ghostty that no reader reports (a config dir not in GHOSTTY_UPDATE_CONFIG_DIRS?): $line")
		fi
	done < <(unplanned_claudes ${plan_pids[@]+"${plan_pids[@]}"})
fi

echo "ghostty-update: $headline"
if [ "$ghostty_running" != true ]; then
	echo "Ghostty is not running, so no session is touched and it is not launched afterwards."
fi
if [ "${#plan_sessions[@]}" -gt 0 ]; then
	echo "Sessions to stop and resume (${#plan_sessions[@]}):"
	for s in "${plan_sessions[@]}"; do
		jq -r '"  \(.name) (\(.id)), \(.how)\(if .carry == "" then "" else ", with \(.carry)" end)"' <<< "$s"
	done
elif [ "$ghostty_running" = true ] && [ "${#refusals[@]}" -eq 0 ]; then
	echo "No Claude Code session is running in Ghostty."
fi
[ "${#alone[@]}" -eq 0 ] || { echo "Left alone:"; printf '  %s\n' "${alone[@]}"; }
if [ "${#refusals[@]}" -gt 0 ]; then
	echo "Refused, since these could not come back as they are:"
	printf '  %s\n' "${refusals[@]}"
	echo "Nothing done. Let them finish, or end them, and run it again."
	exit 1
fi
if [ "$ghostty_running" = true ]; then
	[ "${#plan_sessions[@]}" -eq 0 ] || echo "Unsent text in their input boxes is lost."
	echo "Ghostty asks to confirm quitting if a tab is running something else (an editor, a server); the job waits for your answer. Confirm to update; cancel to keep everything as it was, sessions resumed in their tabs."
fi
if [ "$dry_run" = true ]; then
	echo "Dry run: nothing done."
	exit 0
fi

# --- hand over to the job ---
uid="$(id -u)"
if [ -z "${GHOSTTY_UPDATE_DETACH_BIN:-}" ] \
	&& launchctl print "gui/$uid/$LABEL" 2> /dev/null | grep -q 'state = running'; then
	die "an update is already running (launchd job $LABEL)"
fi
stamp="$(date +%Y%m%d-%H%M%S)"
job_dir="$STATE_DIR/ghostty-update"
log="$STATE_DIR/logs/ghostty-update-$stamp.log"
mkdir -p "$job_dir" "$STATE_DIR/logs" || die "could not create $job_dir"
plan="$job_dir/plan-$stamp.json"
printf '%s\n' "${plan_sessions[@]+"${plan_sessions[@]}"}" | jq -s \
	--arg log "$log" --arg action "$action" --arg from "$installed" --arg to "$target" \
	--arg fv "$from_version" --argjson running "$ghostty_running" --arg caller "$caller" '
	{log: $log, action: $action, from_cask: $from, to_cask: $to, from_version: $fv,
	 ghostty_running: $running, caller: $caller, sessions: .}' > "$plan" || die "could not write $plan"
{
	printf '%s ghostty-update: %s\n' "$(date '+%H:%M:%S')" "$headline"
	printf '  plan: %s\n' "$plan"
} > "$log"

# The job's spec. launchd starts it with nothing of this environment but
# what is named here: the tools' PATH, and the overrides the header
# documents.
spec="$job_dir/job.json"
jq -n --arg label "$LABEL" --arg bash "$BASH" --arg self "$SELF" --arg plan "$plan" --arg log "$log" \
	--arg lang "${LANG:-en_US.UTF-8}" --arg state "$STATE_DIR" '
	{Label: $label, ProgramArguments: [$bash, $self, "--job", $plan],
	 RunAtLoad: true, KeepAlive: false, ProcessType: "Interactive",
	 StandardOutPath: $log, StandardErrorPath: $log,
	 EnvironmentVariables: ({LANG: $lang, DESK_STATE_DIR: $state}
		+ ($ENV | with_entries(select(.key | test("^(PATH|HOME|TMPDIR|DESK_HS_TIMEOUT_SECS|GHOSTTY_UPDATE_[A-Z_]+_SECS)$")))))}' > "$spec" \
	|| die "could not write $spec"
if [ -n "${GHOSTTY_UPDATE_DETACH_BIN:-}" ]; then
	"$GHOSTTY_UPDATE_DETACH_BIN" "$spec" || die "could not start the job"
	echo "Started the job through $GHOSTTY_UPDATE_DETACH_BIN."
else
	plist="$job_dir/job.plist"
	plutil -convert xml1 -o "$plist" "$spec" || die "could not write $plist"
	launchctl bootout "gui/$uid/$LABEL" 2> /dev/null
	launchctl bootstrap "gui/$uid" "$plist" || die "launchctl could not start $plist"
	echo "Started as launchd job $LABEL, outside Ghostty; it acts in ${DELAY_SECS}s and reports in a notification."
fi
echo "Log: $log"
