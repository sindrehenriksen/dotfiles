[user]
	name = sindrehenriksen
	email = sindrehenriksen93@gmail.com

# Machine-local git config — identity overrides and conditional includes for
# checkouts that need a different one. Untracked; ignored if absent.
[include]
	path = ~/.gitconfig.local

[alias]
    c = commit
    ca = commit --amend
    cf = commit --fixup
    s = status
    sw = switch
    b = branch
    co = checkout
    l = log
    lo = log --pretty=lo --date=human
    ps = push
    pnv = push --no-verify
    pl = pull
    d = diff
    dm = diff origin/main...HEAD
    a = add
    f = fetch
    ui = update-index
    uia = update-index --again
    as = update-index --again
    sh = stash
    r = reset
    rb = rebase
    loga = !git lo --graph --all --color
    lom = !git lo main..
    lp = log -p --reverse origin/main..HEAD
    fd = diff-tree --no-commit-id --name-only -r
    fdpc = log --pretty=format:'%h %s%n' --name-only
    cp = cherry-pick
    track-main = b --set-upstream-to origin/main
    hide = update-index --skip-worktree
    unhide = update-index --no-skip-worktree
    unhide-all = !git ls-files -v | grep '^S' | cut -c 3- | xargs -r git update-index --no-skip-worktree

# Shared by lo/loga/lom. Author date, not committer date: a rebase or
# autosquash rewrites the latter, so every commit on a freshly rebased
# branch would carry the same timestamp. --date=human drops what the
# reader can infer (the year on this year's commits, the date itself
# within the past week), so the column is padded to stay a column.
[pretty]
    lo = tformat:%C(auto)%h %C(blue)%<(16)%ad %C(green)%<(16,trunc)%aN%C(auto)%d %C(reset)%s

[rebase]
    autosquash = true
    autostash = true

[pull]
    rebase = false

[fetch]
    prune = true
[push]
	autoSetupRemote = true
[core]
	hooksPath = ~/dotfiles/git-hooks
	# Word-level diff highlighting. Needs the git-delta package on PATH,
	# so install it before this config reaches a new machine.
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	line-numbers = true
	navigate = true
	# Prose here is written as one long line per paragraph, well past
	# delta's 512-char default. Truncating cuts off the changed words.
	max-line-length = 0

[diff]
	colorMoved = default
